+def _separated_gauge_modes_saddle(solver, Aop, Q, normal_rows, n_iter=12):
+    """EXPERIMENT (#1168, candidate B2): as ``_separated_gauge_modes``, but the near-null
+    mode of the whole constrained saddle-point operator (velocity and pressure), by
+    inverse iteration (MUMPS LU) from the constraint-compatible rotation with zero
+    pressure. The constrained normal rows get a unit-scale diagonal in a copy and are
+    re-zeroed in every iterate; the constant pressure mode is removed by pinning one
+    pressure unknown (as the direct-LU route does). The mode keeps its pressure part.
+    Serial experiment."""
+    import time
+    t0 = time.perf_counter()
+    dm = solver.dm
+    A = Aop.copy()
+    diag = A.getDiagonal()
+    dscale = float(diag.norm(PETSc.NormType.INFINITY))
+    rows = np.asarray(normal_rows, dtype=PETSc.IntType)
+    pres = np.asarray(solver._subdict["pressure"][0].getIndices(), dtype=PETSc.IntType)
+    pin = pres[:1]
+    fixed = np.concatenate([rows, pin]).astype(PETSc.IntType)
+    A.zeroRowsColumns(fixed, diag=dscale)
+
+    def _zero_fixed(vec):
+        vec.setValues(fixed, np.zeros(fixed.size))
+        vec.assemble()
+
+    ksp = PETSc.KSP().create(comm=dm.comm)
+    ksp.setOperators(A)
+    ksp.setType("preonly")
+    pc = ksp.getPC()
+    pc.setType("lu")
+    pc.setFactorSolverType("mumps")
+    ksp.setUp()
+    modes, report = [], []
+    for tg in _rigid_rotation_modes(solver):
+        x = _rotated_compatible(Q, tg, normal_rows)
+        dm.restoreGlobalVec(tg)
+        _zero_fixed(x)
+        x.normalize()
+        x0 = x.copy()
+        Ax = x.duplicate()
+        A.mult(x, Ax)
+        res_a = float(Ax.norm()) / dscale
+        y = x.duplicate()
+        for k in range(n_iter):
+            ksp.solve(x, y)
+            _zero_fixed(y)
+            y.normalize()
+            x, y = y, x
+        A.mult(x, Ax)
+        res_b = float(Ax.norm()) / dscale
+        vel = solver._subdict["velocity"][0]
+        sub = x.getSubVector(vel)
+        vel_frac = float(sub.norm())
+        x.restoreSubVector(vel, sub)
+        report.append({"residual_A": res_a, "residual_B2": res_b, "iterations": n_iter,
+                       "B2_minus_A": float(abs(abs(x.dot(x0)) - 1.0)),
+                       "velocity_fraction": vel_frac})
+        modes.append(x)
+        y.destroy()
+        x0.destroy()
+        Ax.destroy()
+    ksp.destroy()
+    A.destroy()
+    diag.destroy()
+    for old in getattr(solver, "_separated_gauge", None) or []:
+        old.destroy()
+    solver._separated_gauge = modes
+    report.append({"seconds": time.perf_counter() - t0})
+    solver._separated_gauge_report = report
+
