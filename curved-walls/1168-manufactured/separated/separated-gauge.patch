+def _separated_gauge_modes(solver, Aop, Q, normal_rows, n_iter=12):
+    """EXPERIMENT (#1168, separated fix, candidate B; private switch
+    ``solver._rotated_separated_gauge``): the gauge vector for each rigid rotation
+    is the constrained velocity operator's own near-null mode, found by inverse
+    iteration (MUMPS LU) from the constraint-compatible rotation (candidate A,
+    development's mode). Where A is already an exact null vector of the
+    constrained operator (equal chords, a radial normal) it is kept as is: the
+    operator is then singular on it and there is nothing to iterate. Stores the
+    rotated-frame full vectors on ``solver._separated_gauge`` and a report on
+    ``solver._separated_gauge_report``. Serial experiment; collective calls only."""
+    import time
+    t0 = time.perf_counter()
+    dm = solver.dm
+    vel_is = solver._subdict["velocity"][0]
+    Avv = Aop.createSubMatrix(vel_is, vel_is)
+    diag = Avv.getDiagonal()
+    dscale = float(diag.norm(PETSc.NormType.INFINITY))
+    # The constrained normal rows/columns of the rotated operator are eliminated;
+    # restrict the iteration to the free unknowns: those rows get a unit-scale
+    # diagonal in this copy (they decouple) and are re-zeroed in every iterate,
+    # so the inverse iteration cannot settle on them.
+    vis = np.asarray(vel_is.getIndices())
+    rstart = Avv.getOwnershipRange()[0]
+    pos = np.searchsorted(vis, np.asarray(normal_rows, dtype=vis.dtype))
+    pos = pos[(pos < vis.size) & (vis[np.minimum(pos, vis.size - 1)] == np.asarray(normal_rows))]
+    sub_rows = (rstart + pos).astype(PETSc.IntType)
+    Avv.zeroRowsColumns(sub_rows, diag=dscale)
+
+    def _zero_constrained(vec):
+        if sub_rows.size:
+            vec.setValues(sub_rows, np.zeros(sub_rows.size))
+            vec.assemble()
+    modes, report = [], []
+    ksp = None
+    for tg in _rigid_rotation_modes(solver):
+        t = _rotated_compatible(Q, tg, normal_rows)
+        dm.restoreGlobalVec(tg)
+        sub = t.getSubVector(vel_is)
+        x = sub.copy()
+        t.restoreSubVector(vel_is, sub)
+        _zero_constrained(x)
+        x.normalize()
+        Ax = x.duplicate()
+        Avv.mult(x, Ax)
+        res_a = float(Ax.norm()) / dscale
+        entry = {"residual_A": res_a, "iterations": 0, "kept_A": True}
+        if res_a > 1.0e-12:
+            if ksp is None:
+                ksp = PETSc.KSP().create(comm=dm.comm)
+                ksp.setOperators(Avv)
+                ksp.setType("preonly")
+                pc = ksp.getPC()
+                pc.setType("lu")
+                pc.setFactorSolverType("mumps")
+                ksp.setUp()
+            y = x.duplicate()
+            x0 = x.copy()
+            for k in range(n_iter):
+                ksp.solve(x, y)
+                _zero_constrained(y)
+                y.normalize()
+                x, y = y, x
+            Avv.mult(x, Ax)
+            res_b = float(Ax.norm()) / dscale
+            entry.update({"residual_B": res_b, "iterations": n_iter, "kept_A": False,
+                          "B_minus_A": float(abs(abs(x.dot(x0)) - 1.0))})
+            y.destroy()
+            x0.destroy()
+        full = t.duplicate()
+        full.set(0.0)
+        fsub = full.getSubVector(vel_is)
+        x.copy(fsub)
+        full.restoreSubVector(vel_is, fsub)
+        _zero_rows_local(full, normal_rows)
+        full.normalize()
+        modes.append(full)
+        t.destroy()
+        x.destroy()
+        Ax.destroy()
+        report.append(entry)
+    if ksp is not None:
+        ksp.destroy()
+    Avv.destroy()
+    diag.destroy()
+    for old in getattr(solver, "_separated_gauge", None) or []:
+        old.destroy()
+    solver._separated_gauge = modes
+    report.append({"seconds": time.perf_counter() - t0})
+    solver._separated_gauge_report = report
+
+
