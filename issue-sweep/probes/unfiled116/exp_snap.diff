+def _ring_crossings_with_holes(Xall, ring, holes):
+    """Proper crossings between the edges of a fill ring and the edges of its holes,
+    and the holes not inside the ring: ``(n_crossings, n_outside)``.
+
+    The orientation test is :func:`_loop_self_crossings`': an orientation within
+    1e-12 of the two edges' lengths' product is zero, on neither side, so a hole that
+    touches the ring at a vertex or along an edge is not a crossing. A hole is inside
+    when none of its vertices lies outside the ring; a vertex on the ring counts as
+    inside."""
+    P = np.asarray(Xall)[np.asarray(ring, dtype=int)]
+    A, B = P, np.roll(P, -1, axis=0)
+    scale = float(np.linalg.norm(P.max(axis=0) - P.min(axis=0))) or 1.0
+    crossings, outside = 0, 0
+    for hole in holes:
+        H = np.asarray(Xall)[np.asarray(hole, dtype=int)]
+        C, D = H, np.roll(H, -1, axis=0)
+
+        def orient(a, b, c):
+            # a, b: (n, 1, 2); c: (1, m, 2) or (n, 1, 2) against (1, m, 2)
+            return ((b[..., 0] - a[..., 0]) * (c[..., 1] - a[..., 1])
+                    - (b[..., 1] - a[..., 1]) * (c[..., 0] - a[..., 0]))
+
+        a, b = A[:, None, :], B[:, None, :]
+        c, d = C[None, :, :], D[None, :, :]
+        tol = 1e-12 * (np.linalg.norm(b - a, axis=-1) * np.linalg.norm(d - c, axis=-1))
+
+        def side(o):
+            return np.where(np.abs(o) <= tol, 0, np.sign(o))
+
+        s1, s2 = side(orient(a, b, c)), side(orient(a, b, d))
+        s3, s4 = side(orient(c, d, a)), side(orient(c, d, b))
+        crossings += int(((s1 * s2 < 0) & (s3 * s4 < 0)).sum())
+        on_ring = _segments_distance(H, P, [(i, (i + 1) % len(P)) for i in range(len(P))]) \
+            <= 1e-12 * scale
+        if any(not on and not _inside_polygon(P, q) for q, on in zip(H, on_ring)):
+            outside += 1
+    return crossings, outside
+
