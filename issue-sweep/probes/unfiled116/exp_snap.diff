+def _exp_snap_direction(P0, t, domain, s):
+    """EXPERIMENT (UNFILED 116): the rail from ``P0`` along ``t`` crosses the wall
+    at X; if a wall vertex lies within s x its local edge length of X, aim the
+    rail at that vertex instead. Logs the move (in local edge lengths) to the
+    file named by UW_EXP_SNAP_LOG."""
+    import os
+    best = (np.inf, None)
+    for L in domain:
+        L = np.asarray(L, dtype=float)
+        n = len(L)
+        for i in range(n):
+            A, B = L[i], L[(i + 1) % n]
+            e = B - A
+            den = t[0] * (-e[1]) - t[1] * (-e[0])
+            if abs(den) < 1e-15:
+                continue
+            q = A - P0
+            lam = (q[0] * (-e[1]) - q[1] * (-e[0])) / den
+            mu = (t[0] * q[1] - t[1] * q[0]) / den
+            if lam > 0 and -1e-12 <= mu <= 1 + 1e-12 and lam < best[0]:
+                best = (lam, (L, i, mu))
+    if best[1] is None:
+        return t
+    L, i, mu = best[1]
+    n = len(L)
+    Xc = P0 + best[0] * t
+    cand = []
+    for j in (i, (i + 1) % n):
+        h_loc = 0.5 * (np.linalg.norm(L[j] - L[j - 1]) + np.linalg.norm(L[(j + 1) % n] - L[j]))
+        cand.append((np.linalg.norm(L[j] - Xc) / h_loc, j))
+    d, j = min(cand)
+    _dbg = os.environ.get("UW_EXP_SNAP_DEBUG")
+    if _dbg:
+        with open(_dbg, "a") as f:
+            f.write(f"P0 ({P0[0]:+.5f},{P0[1]:.5f}) crossing ({Xc[0]:+.5f},{Xc[1]:.5f}) "
+                    f"nearest wall vertex ({L[j][0]:+.5f},{L[j][1]:.5f}) d {d:.4f}\n")
+    if 1e-9 < d < s:
+        v = L[j] - P0
+        log = os.environ.get("UW_EXP_SNAP_LOG")
+        if log:
+            with open(log, "a") as f:
+                f.write(f"{d:.6f}\n")
+        return v / np.linalg.norm(v)
+    return t
+
