-def _check_assembly_area(asm_pts, asm_tris, cad_area):
+def _check_assembly_area(asm_pts, asm_tris, cad_area, simply_connected=False):
     """Refuse an assembly mesh that does not fill its own CAD outlines.
 
-    Two checks. No edge may border more than two triangles, which catches a
-    doubled cell of any size. And the mesh's area must match the CAD's to within
-    what a boundary vertex displaced along the outline can add: the perimeter
-    times 3e-9 of the assembly's diameter.
+    Three checks, the first two exact:
+
+    * no edge borders more than two triangles (a doubled cell, of any size);
+    * with ``simply_connected`` (a ladder assembly, whose outlines have no
+      holes), V - E + F equals the number of connected pieces: a missing cell
+      inside the mesh, of any size, opens a hole and fails it;
+    * the area matches the CAD's to the perimeter times 1e-8 of the diameter, a
+      backstop for a missing cell along the boundary (a notch), which keeps the
+      count.
 
     Measured: on 296 ladder assemblies (an annulus, dips 10-45 degrees, trace tops
     0-3 cells below the wall) the areas agree to 8.3e-16 of the CAD's, except where
     the trace's top lies on the curved wall. There the mesher puts that vertex
-    4.6e-9 from the CAD's, and the excess (1.7e-10, perimeter 0.48, diameter 0.22)
-    needs 1.65e-9 of the diameter. A strip of eight unit cells missing a 1e-6
-    sliver (perimeter 18, diameter 8.06) is refused only below 6.9e-9. So 3e-9 sits
-    within about a factor of two of each; an area check cannot do better than that
-    for a missing piece that small, which is what the edge check is for when the
-    piece is doubled rather than missing."""
+    4.6e-9 from the CAD's, an excess of 1.7e-10 against an allowance of 1.0e-9
+    (perimeter 0.48, diameter 0.22). Every assembly measured has V - E + F = 1."""
     from collections import Counter
     tris = np.asarray(asm_tris, dtype=np.int64)
     edges = Counter(tuple(sorted((int(a), int(b))))
@@ -7438,6 +7439,23 @@ def _check_assembly_area(asm_pts, asm_tris, cad_area):
         raise RuntimeError(
             "the ribbon assembly has an edge shared by more than two triangles; the "
             "layer mesh is not a single layer.")
+    if simply_connected and len(tris):
+        parent = {}
+
+        def root(v):
+            while parent.setdefault(v, v) != v:
+                parent[v] = parent[parent[v]]
+                v = parent[v]
+            return v
+
+        for a, b in edges:
+            parent[root(a)] = root(b)
+        verts = np.unique(tris)
+        pieces = len({root(int(v)) for v in verts})
+        if len(verts) - len(edges) + len(tris) != pieces:
+            raise RuntimeError(
+                "the ribbon assembly has a hole its CAD outline does not: a cell is "
+                "missing from inside the layer mesh.")
     P = asm_pts[tris]
     twice = np.abs((P[:, 1, 0] - P[:, 0, 0]) * (P[:, 2, 1] - P[:, 0, 1])
                    - (P[:, 1, 1] - P[:, 0, 1]) * (P[:, 2, 0] - P[:, 0, 0]))
@@ -7445,7 +7463,7 @@ def _check_assembly_area(asm_pts, asm_tris, cad_area):
     perimeter = sum(float(np.linalg.norm(asm_pts[a] - asm_pts[b]))
                     for (a, b), c in edges.items() if c == 1)
     diameter = float(np.linalg.norm(asm_pts.max(axis=0) - asm_pts.min(axis=0))) if len(asm_pts) else 0.0
-    allowed = max(perimeter * 3e-9 * diameter, 1e-9 * cad_area)
+    allowed = max(perimeter * 1e-8 * diameter, 1e-9 * cad_area)
     if abs(mesh_area - cad_area) > allowed:
         raise RuntimeError(
             f"the ribbon assembly meshed to area {mesh_area:.12e} "
@@ -7488,7 +7506,8 @@ def _thin_volume_assembly_2d(dm, polylines, width, size, assembly, mesher):
             else:
                 asm_pts, asm_tris, cad_area = _occ_assembly_2d(
                     polylines, width, size, assembly, domain=domain_loops)
-            _check_assembly_area(asm_pts, asm_tris, cad_area)
+            _check_assembly_area(asm_pts, asm_tris, cad_area,
+                                 simply_connected=(mesher == "ladder"))
             asm_pts, asm_tris = _collapse_boundary_imprints(
                 asm_pts, asm_tris, domain_loops, 0.1 * size)
             payload = (asm_pts, asm_tris)
