 def test_a_doubled_triangle_is_refused():
     pts, tris, area = _strip()
     with pytest.raises(RuntimeError, match="more than two triangles"):
         _check_assembly_area(pts, np.vstack([tris, tris[:1]]), area + 0.5)
+
+
+def test_a_missing_interior_cell_is_refused_whatever_its_size():
+    """Two rows of cells; one cell inside, touching the boundary only at a
+    vertex or not at all, removed. The hole fails the count exactly."""
+    n = 6
+    pts = np.array([[i, j] for i in range(n + 1) for j in range(3)], dtype=float)
+    tris = []
+    for i in range(n):
+        for j in range(2):
+            a, b = 3 * i + j, 3 * i + j + 1
+            c, d = a + 3, b + 3
+            tris += [[a, c, b], [b, c, d]]
+    tris = np.array(tris)
+    _check_assembly_area(pts, tris, float(2 * n), simply_connected=True)
+    # the upper triangle of the lower-row cell at i = 2 has the middle row's
+    # vertices and one interior edge more: removing it opens a hole
+    hole = [k for k, t in enumerate(tris) if set(t) == {7, 9, 10}][0]
+    with pytest.raises(RuntimeError, match="a cell is missing from inside"):
+        _check_assembly_area(pts, np.delete(tris, hole, axis=0), float(2 * n) - 0.5,
+                             simply_connected=True)
