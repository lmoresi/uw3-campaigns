diff --git a/tests/test_0906_ribbon_assembly_area_at_the_wall.py b/tests/test_0906_ribbon_assembly_area_at_the_wall.py
new file mode 100644
index 00000000..91ed229a
--- /dev/null
+++ b/tests/test_0906_ribbon_assembly_area_at_the_wall.py
@@ -0,0 +1,74 @@
+"""A ribbon whose trace ends on the curved wall is assembled; a missing cell is still refused.
+
+The ribbon's assembly mesh is checked against its CAD area. With the trace's top on
+an annulus's outer wall (a 15-degree dip), the mesher put the top's vertex 4.6e-9 from
+the CAD's, and the areas differed by 2e-8 of the total, against a tolerance of 1e-9:
+"the ribbon assembly meshed to area ... against CAD ...". A zone that outcrops there
+was refused, and a fault there got this message in place of the split's own refusal
+(its top on the boundary). Every other assembly measured agreed to 8.3e-16.
+
+What is asserted: the zone (split=False) is placed and reaches the wall; the fault
+(split=True) gets the split's boundary refusal; and the check itself accepts an
+excess of 1e-4 of the smallest triangle but refuses an assembly missing one triangle.
+"""
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities.place_surface import _check_assembly_area, place_fault_ribbon_2d
+
+pytestmark = [pytest.mark.level_2, pytest.mark.tier_b]
+
+
+@pytest.fixture(scope="module")
+def trace_on_the_wall():
+    base = uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.4, cellSize=0.05,
+                              refinement=1, qdegree=2)
+    h, dip, th = 0.025, np.radians(15.0), np.radians(90.0)
+    # cos(90 degrees) = 6e-17, as the slab probe built it
+    r_hat = np.array([np.cos(th), np.sin(th)])
+    t_hat = np.array([-np.sin(th), np.cos(th)])
+    down = -np.cos(dip) * t_hat - np.sin(dip) * r_hat
+    return base, h, r_hat + (h * np.arange(7))[:, None] * down
+
+
+def test_a_zone_whose_trace_ends_on_the_wall_is_placed(trace_on_the_wall):
+    base, h, trace = trace_on_the_wall
+    mesh, info = place_fault_ribbon_2d(base, [("Zone", trace)], 2 * h, margin_rings=2,
+                                       clearance=0.3, split=False, mesher="ladder")
+    dm = mesh.dm
+    vS, vE = dm.getDepthStratum(0)
+    cS, _cE = dm.getHeightStratum(0)
+    X = dm.getCoordinatesLocal().array.reshape(-1, 2)
+    touching = 0
+    for c in np.flatnonzero(np.asarray(info["band"])):
+        cl = dm.getTransitiveClosure(cS + int(c))[0]
+        v = cl[(cl >= vS) & (cl < vE)] - vS
+        touching += int((np.linalg.norm(X[v], axis=1) > 1 - 1e-6).any())
+    assert uw.mpi.comm.allreduce(touching) > 0
+
+
+def test_a_fault_whose_top_is_on_the_wall_gets_the_splits_refusal(trace_on_the_wall):
+    base, h, trace = trace_on_the_wall
+    with pytest.raises(ValueError, match="the fault touches the domain boundary"):
+        place_fault_ribbon_2d(base, [("Fault", trace)], 2 * h, margin_rings=2,
+                              clearance=0.3, split=True, mesher="ladder")
+
+
+def _strip(n=8):
+    """A unit strip of 2n right triangles, its exact area n."""
+    pts = np.array([[i, j] for i in range(n + 1) for j in (0, 1)], dtype=float)
+    tris = []
+    for i in range(n):
+        a, b, c, d = 2 * i, 2 * i + 1, 2 * i + 2, 2 * i + 3
+        tris += [[a, c, b], [b, c, d]]
+    return pts, np.array(tris), float(n)
+
+
+def test_the_check_accepts_round_off_and_refuses_a_missing_triangle():
+    pts, tris, area = _strip()
+    _check_assembly_area(pts, tris, area)
+    # an excess of 1e-4 of the smallest triangle (0.5), as at the wall
+    _check_assembly_area(pts, tris, area - 1e-4 * 0.5)
+    with pytest.raises(RuntimeError, match="does not fill its own outlines"):
+        _check_assembly_area(pts, tris[1:], area)
