+++ b/src/underworld3/utilities/place_surface.py
@@ -7413,6 +7413,30 @@ def _assembly_edges_on_polylines(asm_pts, edges, polylines, tol):
     return [keys[i] for i in np.flatnonzero(on)]
 
 
+def _check_assembly_area(asm_pts, asm_tris, cad_area):
+    """Refuse an assembly mesh that does not fill its own CAD outlines.
+
+    The check is there to catch a missing or doubled piece, which is at least a
+    triangle's area. So the mesh may differ from the CAD by up to 1e-3 of its
+    smallest triangle, or 1e-9 of the CAD area if that is larger. Measured on
+    296 ladder assemblies (an annulus, dips 10-45 degrees, trace tops 0-3 cells
+    below the wall): every relative difference was at most 8.3e-16, except one
+    of 2.0e-8 (1.7e-10 in area, 1e-4 of the smallest triangle), where the trace's
+    top lies on the curved wall and the mesher puts that vertex 4.6e-9 from the
+    CAD's. The later collapse of boundary imprints removes it, and the final wall
+    vertices lie on the wall to round-off."""
+    P = asm_pts[asm_tris]
+    twice = np.abs((P[:, 1, 0] - P[:, 0, 0]) * (P[:, 2, 1] - P[:, 0, 1])
+                   - (P[:, 1, 1] - P[:, 0, 1]) * (P[:, 2, 0] - P[:, 0, 0]))
+    mesh_area = float(twice.sum() / 2.0)
+    allowed = max(1e-3 * float(twice.min() / 2.0), 1e-9 * cad_area) if len(twice) else 0.0
+    if abs(mesh_area - cad_area) > allowed:
+        raise RuntimeError(
+            f"the ribbon assembly meshed to area {mesh_area:.12e} "
+            f"against CAD {cad_area:.12e}; the layer mesh does not "
+            "fill its own outlines.")
+
+
