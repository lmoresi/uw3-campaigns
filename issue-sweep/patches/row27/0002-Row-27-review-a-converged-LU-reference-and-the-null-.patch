From f200f3df25ceea6dd77699ae93eebab4d80f47d1 Mon Sep 17 00:00:00 2001
From: lmoresi <louis.moresi@anu.edu.au>
Date: Thu, 26 Nov 2026 05:53:29 +1100
Subject: [PATCH 2/2] Row 27 review: a converged LU reference, and the null
 space owned by its shell

test_0895 compared the custom-FMG answer with a direct LU solve at
tolerance 1e-11, which that route does not reach on this annulus: its floor
is about 7e-11 (#1058), and the reference reported "did not converge" while
the test compared against it. The references now solve to 1e-10, which the
route reaches (rnorm/rnorm0 6.9e-11), and the test asserts each converged.

The velocity block's transpose null space was created inline and never
destroyed. _NullModeProjectedPC now holds it beside the modes and destroys
it with them (#1007).

Underworld development team with AI support from Claude Code
---
 src/underworld3/utilities/rotated_bc.py             | 13 ++++++++++---
 ..._0895_rotated_velocity_subsolve_null_mode_rhs.py |  9 +++++++--
 2 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/underworld3/utilities/rotated_bc.py b/src/underworld3/utilities/rotated_bc.py
index 604e5090..489e36b2 100644
--- a/src/underworld3/utilities/rotated_bc.py
+++ b/src/underworld3/utilities/rotated_bc.py
@@ -2946,10 +2946,13 @@ class _NullModeProjectedPC:
     is in the null space attached to the outer solve, so the solution loses nothing by
     keeping it out of the preconditioned directions."""
 
-    def __init__(self, inner, modes):
+    def __init__(self, inner, modes, transpose_nullspace=None):
         self.inner = inner
         self.modes = modes
         self.work = modes[0].duplicate()
+        # the velocity block's transpose null space made from the same modes; the
+        # shell owns it and destroys it with them (#1007)
+        self.transpose_nullspace = transpose_nullspace
 
     def _project(self, v):
         for m in self.modes:
@@ -2974,6 +2977,9 @@ class _NullModeProjectedPC:
         for m in self.modes:
             m.destroy()
         self.modes = []
+        if self.transpose_nullspace is not None:
+            self.transpose_nullspace.destroy()
+            self.transpose_nullspace = None
         if self.work is not None:
             self.work.destroy()
             self.work = None
@@ -2997,8 +3003,9 @@ def _project_exact_null_modes(vel_ksp, nsp, vel_is, comm, tol):
     # mu 1e-4 on test_1157's annulus one sub-solve plateaued at 9e-6 against a target
     # of 3.3e-8 and ran to its 200-iteration cap, and a cold solve took 305 velocity
     # iterations where 57 do, to the same answer (UNFILED 64, register row 27).
-    A_vv.setTransposeNullSpace(PETSc.NullSpace().create(vectors=modes, comm=comm))
-    shell = PETSc.PC().createPython(_NullModeProjectedPC(inner, modes), comm=comm)
+    tns = PETSc.NullSpace().create(vectors=modes, comm=comm)
+    A_vv.setTransposeNullSpace(tns)
+    shell = PETSc.PC().createPython(_NullModeProjectedPC(inner, modes, tns), comm=comm)
     shell.setOperators(A_vv, P_vv)
     vel_ksp.setPC(shell)
     shell.setUp()
diff --git a/tests/test_0895_rotated_velocity_subsolve_null_mode_rhs.py b/tests/test_0895_rotated_velocity_subsolve_null_mode_rhs.py
index 79d378cb..5c507750 100644
--- a/tests/test_0895_rotated_velocity_subsolve_null_mode_rhs.py
+++ b/tests/test_0895_rotated_velocity_subsolve_null_mode_rhs.py
@@ -9,7 +9,8 @@ of 3.3e-8, and the cold solve takes 305 velocity iterations where 57 do (UNFILED
 admitted modes are now the velocity block's transpose null space, so the sub-solve's
 right-hand side is projected as the preconditioner's input is.
 
-The guard puts no-slip on the inner wall: no rotation is a null mode, nothing is admitted,
+The references are direct LU solves at 1e-10, the tightest tolerance that route reaches here
+(#1058), and each must converge. The guard puts no-slip on the inner wall: no rotation is a null mode, nothing is admitted,
 and the solve is the one development makes.
 """
 
@@ -43,8 +44,10 @@ def _annulus(tag, lower="freeslip", lu=False, mu=1.0e-4):
     stokes.add_rotated_freeslip_bc(0, "Upper")
     stokes.petsc_use_pressure_nullspace = True
     if lu:
+        # the direct route's floor on this annulus is ~7e-11 (#1058): 1e-10 is the
+        # tightest tolerance it reaches
         stokes._rotated_use_lu = True
-        stokes.tolerance = 1.0e-11
+        stokes.tolerance = 1.0e-10
     else:
         stokes.tolerance = 1.0e-6
         custom_mg.set_custom_fmg(stokes, mesh._coarse_level_meshes()[:-1], field_id=0)
@@ -65,6 +68,7 @@ def test_the_velocity_subsolve_stops_at_its_target_not_its_cap():
     assert info["sub_capped"]["velocity"] == 0, info["sub_capped"]
     v_lu, direct = _annulus("fslu", lu=True)
     direct.solve(zero_init_guess=True)
+    assert direct._rotated_freeslip_info["converged"], "the LU reference did not converge"
     assert _rel(v.array, v_lu.array) < 1.0e-9
 
 
@@ -76,4 +80,5 @@ def test_no_null_mode_no_change():
     assert stokes._rotated_linear_cache["ctx"]["projected_null_modes"] == 0
     v_lu, direct = _annulus("nslu", lower="noslip", lu=True)
     direct.solve(zero_init_guess=True)
+    assert direct._rotated_freeslip_info["converged"], "the LU reference did not converge"
     assert _rel(v.array, v_lu.array) < 1.0e-7
