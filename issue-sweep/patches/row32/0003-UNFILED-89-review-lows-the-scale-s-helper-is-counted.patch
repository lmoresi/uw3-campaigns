+    monkeypatch.setattr(rotated_bc, "_sum_abs_deterministic", counted)
     scales = set()
     for _ in range(CALLS):
         # a freshly assembled operator each time: new arrays, new placements
@@ -73,3 +83,5 @@ def test_the_diagonal_scale_is_the_same_on_every_call_and_every_assembly():
         Ahat.destroy()
     # development: two values an ulp apart (dasum's alignment)
     assert len(scales) == 1, sorted(scales)
