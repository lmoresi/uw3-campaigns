     T = uw.discretisation.MeshVariable("T1089", mesh, 1, degree=1)
     v = uw.discretisation.MeshVariable("V1089", mesh, 2, degree=2)
@@ -64,6 +66,14 @@ def test_the_diagonal_scale_is_the_same_on_every_call_and_every_assembly():
     stokes.solve()
 
     J, Qt = stokes.snes.getJacobian()[0], stokes._rotated_freeslip_info["Qt"]
+    calls = []
