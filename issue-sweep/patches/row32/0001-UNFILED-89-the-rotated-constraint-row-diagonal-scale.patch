@@ -0,0 +1,64 @@
+"""The rotated route's constraint-row diagonal scale is bit-identical (UNFILED 89).
+
+``_velocity_diag_scale`` (the mean |diag| of the rotated velocity block, written on
+the eliminated wall-normal rows by ``zeroRowsColumns``) was ``NORM_1`` of a
+sub-vector, which is BLAS dasum. On AVX-512 OpenBLAS dasum of the same data gives
+one of two results an ulp apart depending on where the array sits in memory, and
+getSubVector's array lands somewhere new each call. The ulp moved Krylov round-off:
+on H7's warm re-solve fixture (an annulus, viscosity 1 + T, T from 0 to 1) the
+pressure sub-solve took 12, 13 or its 200 cap from run to run at np 2, with the
+same answer.
+
+The scale is now an exactly rounded sum on each rank, and the ranks' sums are
+summed the same way, so every call returns the same bits (in serial, the exact mean).
+"""
+import math
+
+import numpy as np
+import pytest
+import sympy
+
+import underworld3 as uw
+from underworld3.utilities import rotated_bc
+
+pytestmark = [pytest.mark.level_2, pytest.mark.tier_b]
+
+CALLS = 50
+
+
+def test_the_diagonal_scale_is_the_same_on_every_call():
+    mesh = uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.5, cellSize=0.2, qdegree=3)
+    T = uw.discretisation.MeshVariable("T1089", mesh, 1, degree=1)
+    v = uw.discretisation.MeshVariable("V1089", mesh, 2, degree=2)
+    p = uw.discretisation.MeshVariable("P1089", mesh, 1, degree=1)
+    stokes = uw.systems.Stokes(mesh, velocityField=v, pressureField=p)
+    stokes.constitutive_model = uw.constitutive_models.ViscousFlowModel
+    stokes.constitutive_model.Parameters.shear_viscosity_0 = 1.0 + T.sym[0]
+    X = mesh.X
+    r = sympy.sqrt(X[0] ** 2 + X[1] ** 2)
+    th = sympy.atan2(X[1], X[0])
+    stokes.bodyforce = (sympy.cos(3 * th) * sympy.sin(sympy.pi * (r - 0.5) / 0.5)
+                        * sympy.Matrix([X[0] / r, X[1] / r]))
+    stokes.add_rotated_freeslip_bc(0, "Lower")
+    stokes.add_rotated_freeslip_bc(0, "Upper")
+    stokes.petsc_use_pressure_nullspace = True
+    stokes.tolerance = 1.0e-8
+    stokes.solve()
+
+    info = stokes._rotated_freeslip_info
+    Ahat = stokes.snes.getJacobian()[0].ptap(info["Qt"])
+    scales = {rotated_bc._velocity_diag_scale(Ahat, stokes).hex() for _ in range(CALLS)}
+
+    # the reference, independently: each rank's exactly rounded sum of |diag| over
+    # its velocity rows, then the ranks' sums summed the same way (exact in serial)
+    d = Ahat.getDiagonal()
+    sub = d.getSubVector(stokes._subdict["velocity"][0])
+    n = sub.getSize()
+    local = math.fsum(np.abs(np.asarray(sub.getArray(readonly=True))).tolist())
+    d.restoreSubVector(stokes._subdict["velocity"][0], sub)
+    d.destroy()
+    Ahat.destroy()
+    exact = math.fsum(uw.mpi.comm.allgather(local)) / n
+
+    # development: two values an ulp apart within one process (dasum's alignment)
+    assert scales == {exact.hex()}, (sorted(scales), exact.hex())
