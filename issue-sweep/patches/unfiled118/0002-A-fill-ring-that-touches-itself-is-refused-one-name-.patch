+@pytest.mark.parametrize("ring, vertex, edge", [(_RING_DIP15, 27, 24), (_RING_DIP10, 33, 30)],
+                         ids=["dip15", "dip10"])
+def test_a_ring_touching_itself_is_refused(ring, vertex, edge):
+    assert _loop_self_crossings(ring) == 0
+    rel, i, j = _ring_self_touch(ring)
+    assert (i, j) == (vertex, edge) and rel < 1e-12
+    x, y = ring[vertex]
+    with pytest.raises(ValueError, match=rf"touches itself: its vertex at \({x:.6g}, {y:.6g}\)"):
+        _refuse_a_ring_touching_itself(ring, _all(ring))
+
+
+def _moved_inside(rel):
+    P = _RING_DIP15.copy()
+    e = P[25] - P[24]
+    P[27] = P[27] + rel * np.array([-e[1], e[0]])
+    return P
+
+
+@pytest.mark.parametrize("rel", [1e-6, 1e-2])
+def test_the_vertex_moved_inside_passes(rel):
+    P = _moved_inside(rel)
+    assert _loop_self_crossings(P) == 0
+    _refuse_a_ring_touching_itself(P, _all(P))
+
+
+def test_a_vertex_within_the_tolerance_is_refused():
+    # gmsh meshes the ring at 1e-12 inside, but only with a cell 1e-12 of the edge
+    # across: the guard's 1e-9 refuses it on purpose
+    P = _moved_inside(1e-12)
+    with pytest.raises(ValueError, match="touches itself"):
+        _refuse_a_ring_touching_itself(P, _all(P))
+
+
+def test_the_closest_completing_ring_passes():
+    rel, _, _ = _ring_self_touch(_RING_PASSING)
+    assert 1e-2 < rel < 3e-2
+    _refuse_a_ring_touching_itself(_RING_PASSING, _all(_RING_PASSING))
