+def _inside_polygon_many(P, Q):
+    """:func:`_inside_polygon` for every row of ``Q`` at once."""
+    P = np.asarray(P, dtype=float)
+    Q = np.asarray(Q, dtype=float).reshape(-1, 2)
+    tol = 1e-12 * float(np.linalg.norm(P.max(axis=0) - P.min(axis=0)))
+    x0, y0 = P[None, :, 0], P[None, :, 1]
+    R = np.roll(P, -1, axis=0)
+    x1, y1 = R[None, :, 0], R[None, :, 1]
+    x, y = Q[:, None, 0], Q[:, None, 1]
+    # on an edge: within tol of the edge's line and within its span
+    cross = (x1 - x0) * (y - y0) - (y1 - y0) * (x - x0)
+    on = ((np.abs(cross) <= tol * np.hypot(x1 - x0, y1 - y0))
+          & (np.minimum(x0, x1) - tol <= x) & (x <= np.maximum(x0, x1) + tol)
+          & (np.minimum(y0, y1) - tol <= y) & (y <= np.maximum(y0, y1) + tol))
+    straddle = (y0 > y) != (y1 > y)
+    dy = np.where(straddle, y1 - y0, 1.0)
+    xi = x0 + (y - y0) * (x1 - x0) / dy
+    hits = (straddle & (x < xi)).sum(axis=1)
+    return (hits % 2 == 1) & ~on.any(axis=1)
 
 
