+def test_the_inside_test_is_relative_to_the_rings_size(scale):
+    ring = scale * np.array([[0.0, 0.0], [1.0, 0.0], [1.0, 1.0], [0.0, 1.0]])
+    hole = scale * np.array([[0.4, 0.0], [0.6, 0.3], [0.4, 0.3]])
+    hole[0, 1] += 1e-9 * scale                     # 1e-15 inside the edge at scale 1e-6
+    X = np.vstack([ring, hole])
