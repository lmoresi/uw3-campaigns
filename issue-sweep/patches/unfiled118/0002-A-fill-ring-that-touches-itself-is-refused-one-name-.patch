+def _ring_self_touch(P):
+    """The closest a vertex of the closed polygon ``P`` comes to an edge of it that
+    does not end at that vertex, relative to the shorter of that edge and the
+    vertex's own two edges: ``(relative distance, vertex, edge)``, the edge named by
+    its first vertex. A touch (a vertex lying on another edge) is not a proper
+    crossing, so :func:`_loop_self_crossings` does not count it."""
+    P = np.asarray(P, dtype=float)
+    n = len(P)
+    if n < 4:
+        return np.inf, None, None
+    E = np.roll(P, -1, axis=0) - P
+    L = np.linalg.norm(E, axis=1)
+    rel = P[:, None, :] - P[None, :, :]                        # vertex i against edge j
+    u = np.clip((rel * E[None]).sum(-1) / (L * L)[None], 0.0, 1.0)
+    d = np.linalg.norm(rel - u[..., None] * E[None], axis=-1)
+    own = np.minimum(L, np.roll(L, 1))                         # vertex i's two edges
+    d = d / np.minimum(L[None, :], own[:, None])
+    i = np.arange(n)
+    d[i, i] = np.inf
+    d[i, (i - 1) % n] = np.inf
+    k = int(np.argmin(d))
+    return float(d.flat[k]), k // n, k % n
+
