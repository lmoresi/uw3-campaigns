+def _refuse_a_ring_touching_itself(Xall, ring):
+    """Refuse a fill whose ring has a vertex on one of its own non-adjacent edges
+    (within ``_RING_TOUCH_REL`` of the edge): gmsh does not refuse such a boundary,
+    it spins (measured: a cavity ring with a rail point projected onto a wall edge of
+    the same ring, at 1e-15 of the edge; rings of placements that complete come no
+    closer than 1.8e-2). Raised before any meshing, inside the placement's failure
+    gather, so every rank refuses."""
+    P = np.asarray(Xall)[np.asarray(ring, dtype=int)]
+    rel, i, j = _ring_self_touch(P)
+    if rel <= _RING_TOUCH_REL:
+        raise ValueError(
+            f"the fill ring touches itself: its vertex at ({P[i][0]:.6g}, "
+            f"{P[i][1]:.6g}) lies on the ring's edge from ({P[j][0]:.6g}, "
+            f"{P[j][1]:.6g}) to ({P[(j + 1) % len(P)][0]:.6g}, "
+            f"{P[(j + 1) % len(P)][1]:.6g}), {rel:.1e} of the edge length away; "
+            f"the cavity's boundary pinches there and is not one this placement can fill")
 
 
