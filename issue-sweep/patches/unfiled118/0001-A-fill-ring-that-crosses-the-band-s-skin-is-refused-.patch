diff --git a/src/underworld3/utilities/place_surface.py b/src/underworld3/utilities/place_surface.py
index acf05296..c128d36d 100644
--- a/src/underworld3/utilities/place_surface.py
+++ b/src/underworld3/utilities/place_surface.py
@@ -6598,6 +6598,58 @@ def _loop_self_crossings(P):
     return count
 
 
+def _ring_crossings_with_holes(Xall, ring, holes):
+    """Proper crossings between the edges of a fill ring and the edges of its holes,
+    and the holes not inside the ring: ``(n_crossings, n_outside)``.
+
+    The orientation test is :func:`_loop_self_crossings`': an orientation within
+    1e-12 of the two edges' lengths' product is zero, on neither side, so a hole that
+    touches the ring at a vertex or along an edge is not a crossing. A hole is inside
+    when none of its vertices lies outside the ring; a vertex on the ring counts as
+    inside."""
+    P = np.asarray(Xall)[np.asarray(ring, dtype=int)]
+    A, B = P, np.roll(P, -1, axis=0)
+    scale = float(np.linalg.norm(P.max(axis=0) - P.min(axis=0))) or 1.0
+    crossings, outside = 0, 0
+    for hole in holes:
+        H = np.asarray(Xall)[np.asarray(hole, dtype=int)]
+        C, D = H, np.roll(H, -1, axis=0)
+
+        def orient(a, b, c):
+            # a, b: (n, 1, 2); c: (1, m, 2) or (n, 1, 2) against (1, m, 2)
+            return ((b[..., 0] - a[..., 0]) * (c[..., 1] - a[..., 1])
+                    - (b[..., 1] - a[..., 1]) * (c[..., 0] - a[..., 0]))
+
+        a, b = A[:, None, :], B[:, None, :]
+        c, d = C[None, :, :], D[None, :, :]
+        tol = 1e-12 * (np.linalg.norm(b - a, axis=-1) * np.linalg.norm(d - c, axis=-1))
+
+        def side(o):
+            return np.where(np.abs(o) <= tol, 0, np.sign(o))
+
+        s1, s2 = side(orient(a, b, c)), side(orient(a, b, d))
+        s3, s4 = side(orient(c, d, a)), side(orient(c, d, b))
+        crossings += int(((s1 * s2 < 0) & (s3 * s4 < 0)).sum())
+        on_ring = _segments_distance(H, P, [(i, (i + 1) % len(P)) for i in range(len(P))]) \
+            <= 1e-12 * scale
+        if any(not on and not _inside_polygon(P, q) for q, on in zip(H, on_ring)):
+            outside += 1
+    return crossings, outside
+
+
+def _refuse_a_ring_crossing_the_band(Xall, ring, holes):
+    """Refuse a fill whose ring crosses its holes (the band's skin) or leaves one
+    outside: gmsh does not refuse such a boundary, it spins (measured: one rank of a
+    seam-conforming placement in GFaceInitialMesh while the others waited). Raised
+    before any meshing, inside the placement's failure gather, so every rank refuses."""
+    crossings, outside = _ring_crossings_with_holes(Xall, ring, holes)
+    if crossings or outside:
+        raise ValueError(
+            f"the fill ring crosses the band's skin {crossings} time(s) and leaves "
+            f"{outside} hole(s) outside it; the cavity's boundary is not one this "
+            f"placement can fill")
+
+
 def _segments_cross(P, Q, A, B):
     """Whether segment PQ crosses segment AB (proper or touching)."""
     def orient(a, b, c):
@@ -6674,6 +6726,17 @@ def _conform_fill_loops_2d(rings, X, victim, seam_edge_set, asm_pts,
             if crossing:
                 span_ends += [v1, v2]
             else:
+                # the span's own seam edges do not meet the band, but a straight
+                # connector between its ends can still cut across the band's tip
+                # where the seam skirted it (a 5.4-cell chord at np 3, which hung
+                # gmsh on one rank)
+                if _edge_meets_band(X[v1], X[v2], asm_pts, loops_asm):
+                    raise RuntimeError(
+                        "seam-conforming placement: the band's tip lies across the "
+                        "seam near a span the band does not cross, so the straight "
+                        "connector closing that span would cut through the band. "
+                        "This path does not place it; use seams='gather' (the "
+                        "default).")
                 link(v1, v2)
         for i in range(n):
             if not removed[i]:
@@ -8229,6 +8292,7 @@ def _place_thin_volume_2d(dm, polylines, width, label, label_value,
                     if n_x:
                         raise ValueError(
                             f"the fill ring crosses itself {n_x} time(s)")
+                    _refuse_a_ring_crossing_the_band(Xall, ring, holes)
                     gap_tris, extra = _gmsh_fill_2d(Xall, ring, None,
                                                     holes=holes,
                                                     size_of=size_of)
