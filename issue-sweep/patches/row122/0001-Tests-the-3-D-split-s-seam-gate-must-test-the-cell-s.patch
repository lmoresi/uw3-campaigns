new file mode 100644
index 00000000..24ac350f
--- /dev/null
+++ b/tests/test_0912_3d_split_gate_tests_the_cell_star.py
@@ -0,0 +1,86 @@
+"""The 3-D split's seam test reads the closure of the patch's cell star.
+
+_patch_star_touches_seam is the test split_along_label_3d refuses on, and the one
+split_fault's gate applies in 3-D, so the two cannot disagree. Here on a serial patch
+with the shared points marked by hand: nothing shared is no touch; a vertex of a star
+cell that is in no fault facet's closure (the point the facet-only gate missed) is a
+touch; a vertex outside every star cell's closure is not; a fault vertex is; and a
+rank that sees only part of the patch (one face's vertices) finds a shared point
+around that part. The parallel case, with a hand-built partition, is
+tests/parallel/test_0912_3d_split_gate_tests_the_cell_star_parallel.py.
+"""
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities.fault_split import _patch_star_touches_seam
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b,
+              pytest.mark.skipif(uw.mpi.size > 1, reason="serial: shared points marked by hand")]
+
+PATCH = np.array([[0.4, 0.35, 0.35], [0.4, 0.65, 0.35],
+                  [0.4, 0.65, 0.65], [0.4, 0.35, 0.65]])
+
+
+@pytest.fixture(scope="module")
+def patch():
+    mesh = uw.meshing.BoxInternalPatch(cellSize=0.15, minCoords=(0, 0, 0),
+                                       maxCoords=(2, 1, 1), patch_points=PATCH,
+                                       patch_name="FltA")
+    dm = mesh.dm
+    value = int(mesh.boundaries["FltA"].value)
+    fS, fE = dm.getHeightStratum(1)
+    vS, vE = dm.getDepthStratum(0)
+    cS, cE = dm.getHeightStratum(0)
+    faces = [int(f) for f in dm.getLabel("FltA").getStratumIS(value).getIndices()
+             if fS <= int(f) < fE]
+    facet_closure = {int(p) for f in faces for p in dm.getTransitiveClosure(f)[0]}
+    verts = {p for p in facet_closure if vS <= p < vE}
+    closure = {c: {int(p) for p in dm.getTransitiveClosure(c)[0]} for c in range(cS, cE)}
+    star = [c for c in range(cS, cE) if closure[c] & verts]
+    star_closure = set().union(*(closure[c] for c in star))
+    return dm, faces, facet_closure, verts, closure, star_closure
+
+
+def _shared(dm, points=()):
+    pStart, pEnd = dm.getChart()
+    flag = np.zeros(pEnd - pStart, dtype=np.int32)
+    for p in points:
+        flag[int(p) - pStart] = 1
+    return flag
+
+
+def test_nothing_shared_is_no_touch(patch):
+    dm, _faces, _fc, verts, _cl, _sc = patch
+    assert not _patch_star_touches_seam(dm, verts, _shared(dm))
+
+
+def test_a_star_vertex_off_the_facets_is_a_touch(patch):
+    dm, _faces, facet_closure, verts, _cl, star_closure = patch
+    vS, vE = dm.getDepthStratum(0)
+    outer = sorted(p for p in star_closure - facet_closure if vS <= p < vE)
+    assert outer
+    assert _patch_star_touches_seam(dm, verts, _shared(dm, [outer[0]]))
+
+
+def test_a_vertex_outside_the_star_is_no_touch(patch):
+    dm, _faces, _fc, verts, closure, star_closure = patch
+    vS, vE = dm.getDepthStratum(0)
+    every = set().union(*closure.values())
+    away = sorted(p for p in every - star_closure if vS <= p < vE)
+    assert away
+    assert not _patch_star_touches_seam(dm, verts, _shared(dm, [away[0]]))
+
+
+def test_a_fault_vertex_is_a_touch(patch):
+    dm, _faces, _fc, verts, _cl, _sc = patch
+    assert _patch_star_touches_seam(dm, verts, _shared(dm, [min(verts)]))
+
+
+def test_a_fragment_of_the_patch_finds_the_seam_around_it(patch):
+    dm, faces, _fc, _verts, closure, _sc = patch
+    vS, vE = dm.getDepthStratum(0)
+    part = {int(p) for p in dm.getTransitiveClosure(faces[0])[0] if vS <= int(p) < vE}
+    around = set().union(*(cl for cl in closure.values() if cl & part))
+    outer = sorted(p for p in around - part if vS <= p < vE)
+    assert _patch_star_touches_seam(dm, part, _shared(dm, [outer[0]]))
