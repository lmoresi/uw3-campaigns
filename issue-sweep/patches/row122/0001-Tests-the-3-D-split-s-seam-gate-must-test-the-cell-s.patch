diff --git a/tests/parallel/test_0912_3d_split_gate_tests_the_cell_star_parallel.py b/tests/parallel/test_0912_3d_split_gate_tests_the_cell_star_parallel.py
new file mode 100644
index 00000000..a620742b
--- /dev/null
+++ b/tests/parallel/test_0912_3d_split_gate_tests_the_cell_star_parallel.py
@@ -0,0 +1,109 @@
+"""The 3-D split's seam gate tests the cell star's closure, the set the split refuses on.
+
+split_along_label_3d refuses when any point in the closure of a cell with a vertex on the
+patch is shared. split_fault's gate tested only the fault facets and the points below
+them (the 2-D split's rule), so a partition that leaves the facets seam-free but puts
+the star's outer vertices on the seam was not repartitioned, and the split refused
+("cell star touches the partition seam"); ptest_0848 met it at np 3.
+
+The partition here is built by hand, so the fixture does not depend on where the
+default partitioner cuts: every star cell on rank 0, every other cell on the ranks
+above it by x. The fixture is checked first (no facet point shared anywhere, a
+star-closure point shared somewhere). Asserted: the gate says touch on every rank, and
+split_fault succeeds on every rank.
+"""
+import numpy as np
+import pytest
+from mpi4py import MPI
+from petsc4py import PETSc
+
+import underworld3 as uw
+from underworld3.utilities.addon_partition import mark_labels
+from underworld3.utilities.fault_split import (_fault_labels_touch_seam,
+                                               _shared_points, split_fault)
+from underworld3.utilities.place_surface import _region_cells
+
+pytestmark = [pytest.mark.mpi(min_size=2), pytest.mark.level_2, pytest.mark.tier_b,
+              pytest.mark.timeout(600)]
+
+PATCH = np.array([[0.4, 0.35, 0.35], [0.4, 0.65, 0.35],
+                  [0.4, 0.65, 0.65], [0.4, 0.35, 0.65]])
+
+
+def _star_on_rank_zero(mesh, labels):
+    """A new Mesh over ``mesh`` with the patch's cell star on rank 0, the rest above."""
+    comm = uw.mpi.comm
+    work = mesh.dm.clone()
+    cS, cE = work.getHeightStratum(0)
+    cell_region, _canon, _regions = _region_cells(work, mark_labels(labels)(work), layers=0)
+    vS, _vE = work.getDepthStratum(0)
+    X = np.asarray(work.getCoordinatesLocal().array).reshape(-1, 3)
+    x = np.array([X[[int(p) - vS for p in work.getTransitiveClosure(c)[0]
+                     if vS <= int(p) < vS + len(X)]][:, 0].mean() for c in range(cS, cE)])
+    others = comm.size - 1
+    assign = np.where(cell_region > 0, 0,
+                      1 + np.minimum((x / 2.0 * others).astype(np.int32), others - 1))
+    assign = assign.astype(np.int32)
+    order = np.argsort(assign, kind="stable").astype(np.int32)
+    sizes = np.bincount(assign, minlength=comm.size).astype(np.int32)
+    part = work.getPartitioner()
+    part.setType(PETSc.Partitioner.Type.SHELL)
+    part.setShellPartition(comm.size, sizes=sizes, points=order)
+    work.distribute()
+    moved = uw.discretisation.Mesh(
+        work, simplex=True, qdegree=mesh.qdegree,
+        coordinate_system_type=mesh.CoordinateSystem.coordinate_type,
+        boundaries=mesh.boundaries, verbose=False)
+    for attr in ("_fault_traces", "_fault_specs", "_fault_surfaces",
+                 "_fault_seam_normals", "_embedded_surfaces"):
+        if getattr(mesh, attr, None) is not None:
+            setattr(moved, attr, getattr(mesh, attr))
+    return moved
+
+
+def _shared_in_closure(dm, points, shared):
+    pStart, _pEnd = dm.getChart()
+    for p in points:
+        closure = np.asarray(dm.getTransitiveClosure(int(p))[0], dtype=np.int64)
+        if shared[closure - pStart].any():
+            return True
+    return False
+
+
+def test_a_star_on_the_seam_is_repartitioned_and_split():
+    comm = uw.mpi.comm
+    mesh = uw.meshing.BoxInternalPatch(cellSize=0.15, minCoords=(0, 0, 0),
+                                       maxCoords=(2, 1, 1), patch_points=PATCH,
+                                       patch_name="FltA")
+    labels = [("FltA", int(mesh.boundaries["FltA"].value))]
+    moved = _star_on_rank_zero(mesh, labels)
+    dm = moved.dm
+
+    # the fixture: the facets are seam-free, the star's closure is not
+    shared = _shared_points(dm)
+    fS, fE = dm.getHeightStratum(1)
+    name, value = labels[0]
+    faces = []
+    if dm.hasLabel(name) and dm.getLabel(name).getStratumSize(value) > 0:
+        faces = [int(f) for f in dm.getLabel(name).getStratumIS(value).getIndices()
+                 if fS <= int(f) < fE]
+    facet_touch = comm.allreduce(_shared_in_closure(dm, faces, shared), op=MPI.LOR)
+    cS, cE = dm.getHeightStratum(0)
+    vS, vE = dm.getDepthStratum(0)
+    patch_verts = {int(p) for f in faces for p in dm.getTransitiveClosure(f)[0]
+                   if vS <= int(p) < vE}
+    star = [c for c in range(cS, cE)
+            if patch_verts & {int(p) for p in dm.getTransitiveClosure(c)[0]}]
+    star_touch = comm.allreduce(_shared_in_closure(dm, star, shared), op=MPI.LOR)
+    assert not facet_touch and star_touch, (facet_touch, star_touch)
+
+    verdicts = comm.allgather(_fault_labels_touch_seam(dm, labels))
+    assert all(verdicts), verdicts
+
+    message = None
+    try:
+        split_fault(moved, "FltA")
+    except (RuntimeError, ValueError) as exc:
+        message = f"{type(exc).__name__}: {exc}"
+    messages = comm.allgather(message)
+    assert all(m is None for m in messages), messages
