diff --git a/tests/test_0908_pressure_subsolve_cap_is_the_users.py b/tests/test_0908_pressure_subsolve_cap_is_the_users.py
new file mode 100644
index 00000000..5b041c16
--- /dev/null
+++ b/tests/test_0908_pressure_subsolve_cap_is_the_users.py
@@ -0,0 +1,59 @@
+"""The pressure sub-solve's iteration cap is the user's to set, on both Stokes paths.
+
+The cap is ``fieldsplit_pressure_ksp_max_it`` (default 200). Two things defeated it:
+
+* setting ``strategy`` after the option wrote 200 back over the user's value;
+* the rotated free-slip path builds its own Krylov solver under a per-solve prefix
+  and fixed its pressure cap at 200, so no option reached it. On P2/dP1 triangle
+  meshes, where the Schur complement is poorly conditioned, that cap could not be
+  raised.
+
+What is asserted: a value set before ``strategy`` survives it (for the velocity cap
+too); and the rotated solve's live pressure sub-solver carries the value set on the
+solver's options.
+"""
+import pytest
+import sympy
+
+import underworld3 as uw
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
+
+
+def _stokes(mesh, p_continuous=True):
+    v = uw.discretisation.MeshVariable("v0908", mesh, 2, degree=2)
+    p = uw.discretisation.MeshVariable("p0908", mesh, 1, degree=1, continuous=p_continuous)
+    s = uw.systems.Stokes(mesh, velocityField=v, pressureField=p)
+    s.constitutive_model = uw.constitutive_models.ViscousFlowModel
+    s.constitutive_model.Parameters.shear_viscosity_0 = 1
+    return s
+
+
+def test_a_users_caps_survive_a_later_strategy():
+    mesh = uw.meshing.UnstructuredSimplexBox(cellSize=0.25)
+    s = _stokes(mesh)
+    s.petsc_options["fieldsplit_pressure_ksp_max_it"] = 777
+    s.petsc_options["fieldsplit_velocity_ksp_max_it"] = 555
+    s.strategy = "fast"
+    assert s.petsc_options.getInt("fieldsplit_pressure_ksp_max_it") == 777
+    assert s.petsc_options.getInt("fieldsplit_velocity_ksp_max_it") == 555
+
+
+def test_a_strategy_alone_keeps_the_default():
+    mesh = uw.meshing.UnstructuredSimplexBox(cellSize=0.25)
+    s = _stokes(mesh)
+    s.strategy = "robust"
+    assert s.petsc_options.getInt("fieldsplit_pressure_ksp_max_it") == 200
+
+
+def test_the_rotated_pressure_subsolve_takes_the_users_cap():
+    mesh = uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.5, cellSize=0.2, qdegree=3)
+    s = _stokes(mesh, p_continuous=False)
+    r = sympy.sqrt(mesh.X[0] ** 2 + mesh.X[1] ** 2)
+    s.bodyforce = sympy.Matrix(mesh.X) / r * sympy.cos(3 * sympy.atan2(mesh.X[1], mesh.X[0]))
+    s.add_rotated_freeslip_bc(0, "Upper")
+    s.add_rotated_freeslip_bc(0, "Lower")
+    s.petsc_options["fieldsplit_pressure_ksp_max_it"] = 777
+    s.solve()
+    pressure = s._rotated_linear_cache["ctx"]["ksp"].getPC().getFieldSplitSubKSP()[1]
+    assert pressure.getTolerances()[3] == 777
