             return strategy
         return "robust"
 
+    def _push_default_option(self, key, value):
+        """Write a framework default that a user's own value must survive.
+
+        The key is written unless it already holds a value other than the one this
+        method last wrote there: that value is the user's (set on ``petsc_options``
+        or on the command line) and is left alone, so a later ``strategy`` change
+        cannot overwrite it. A user value equal to the framework default cannot be
+        told apart from it, which is harmless while every writer of the key writes
+        that same default.
+
+        The record is its own, not ``_managed_pc_options``: that one decides which
+        multigrid-bundle keys count as the user's, and these writes must not change
+        that.
+        """
+        if not hasattr(self, "_framework_defaults"):
+            self._framework_defaults = {}
+        if self.petsc_options.hasName(key):
+            current = self.petsc_options.getString(key)
+            if current != self._framework_defaults.get(key):
+                return
+        self.petsc_options[key] = value
+        self._framework_defaults[key] = multigrid_options.option_string(value)
+
     def _push_managed_option(self, key, value):
         """Write a PETSc option UW3 owns, recording that we wrote it.
 
