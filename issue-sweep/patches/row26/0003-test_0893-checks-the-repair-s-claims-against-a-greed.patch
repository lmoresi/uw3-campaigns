-"""The barycentric builder's orphan repair runs in memory linear in the orphans.
+"""The barycentric builder's orphan repair: the greedy claims, in memory linear in the orphans.
 
-The repair gives each orphan coarse DOF (a column with no fine image) its nearest
-unclaimed fine DOF. It used to query orphans + 8 neighbours for every orphan at
-once, an (orphans x orphans) array: 8.6 GB per rank on #893's hierarchy. The
-fixture forces 1,770 orphans by putting the fine cloud in the left half of the
-coarse one; that query held 55 MB here, the bounded one 4 MB.
+The repair gives each orphan coarse DOF (a column with no fine image), in column order, its
+nearest fine DOF not yet claimed, equal distances going to the lower fine index. It used to
+query orphans + 8 neighbours for every orphan at once, an (orphans x orphans) array: 8.6 GB
+per rank on #893's hierarchy. The query is now bounded and widened per orphan only while its
+candidates are taken.
+
+The claims are checked against a brute-force greedy reference, with the orphans taken from
+the build without the repair, so the check does not depend on how the platform's Delaunay
+splits a tie. The cloud is random, so there are no ties: the greedy result is unique. The
+fine cloud fills the left half of the coarse one, which forces orphans whose nearest fine DOFs
+are all claimed and so exercises the widening (a query held at 9 neighbours fails here).
 """
 
 import tracemalloc
@@ -17,10 +23,43 @@ from underworld3.utilities import custom_mg
 pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
 
 
-def test_orphan_repair_memory_is_bounded():
-    g = np.linspace(0.0, 1.0, 60)
-    coarse = np.array([(x, y) for x in g for y in g])
-    fine = np.random.default_rng(0).random((3600, 2)) * [0.5, 1.0]
+def _clouds(n=3600):
+    rng = np.random.default_rng(893)
+    coarse = rng.random((n, 2))
+    fine = rng.random((n, 2)) * [0.5, 1.0]
+    return coarse, fine
+
+
+def _greedy_reference(coarse, fine, orphans):
+    taken = np.zeros(len(fine), dtype=bool)
+    claims = {}
+    for c in orphans:
+        if taken.all():
+            break
+        d = np.linalg.norm(fine - coarse[c], axis=1)
+        d[taken] = np.inf
+        f = int(np.lexsort((np.arange(len(fine)), d))[0])
+        taken[f] = True
+        claims[f] = int(c)
+    return claims
+
+
+def _claims(P, P0):
+    """The fine rows the repair rewrote, as {row: orphan column}."""
+    changed = np.flatnonzero(np.asarray((P != P0).sum(axis=1)).ravel())
+    out = {}
+    for r in changed:
+        row = P.getrow(r)
+        assert row.nnz == 1 and row.data[0] == 1.0, (r, row)
+        out[int(r)] = int(row.indices[0])
+    return out
+
+
+def test_the_repair_makes_the_greedy_claims_in_bounded_memory():
+    coarse, fine = _clouds()
+    P0 = custom_mg.barycentric_prolongation(coarse, fine, repair_orphans=False)
+    orphans = np.flatnonzero(np.asarray((P0 != 0).sum(axis=0)).ravel() == 0)
+    assert len(orphans) > 1000
 
     stats = {}
     tracemalloc.start()
@@ -29,11 +68,21 @@ def test_orphan_repair_memory_is_bounded():
         peak = tracemalloc.get_traced_memory()[1]
     finally:
         tracemalloc.stop()
-
     assert peak < 20.0e6, f"orphan repair peaked at {peak / 1e6:.1f} MB"
-    # the claims themselves are unchanged (hard baseline, development's builder)
-    assert stats["orphans_repaired"] == 1770
-    assert P.nnz == 7260
-    empty = np.asarray((P != 0).sum(axis=0)).ravel() == 0
-    assert int(empty.sum()) == 877
+
+    reference = _greedy_reference(coarse, fine, orphans)
+    assert _claims(P, P0) == reference
+    assert stats["orphans_repaired"] == len(orphans)
+    assert stats["orphans_claimed"] == len(reference)
     np.testing.assert_allclose(np.asarray(P.sum(axis=1)).ravel(), 1.0, rtol=0, atol=1e-14)
+
+
+def test_a_single_fine_dof_takes_the_first_orphan():
+    coarse, _fine = _clouds(40)
+    fine = np.array([[0.25, 0.5]])
+    stats = {}
+    P = custom_mg.barycentric_prolongation(coarse, fine, stats=stats)
+    P0 = custom_mg.barycentric_prolongation(coarse, fine, repair_orphans=False)
+    orphans = np.flatnonzero(np.asarray((P0 != 0).sum(axis=0)).ravel() == 0)
+    assert _claims(P, P0) == {0: int(orphans[0])}
+    assert stats["orphans_claimed"] == 1
