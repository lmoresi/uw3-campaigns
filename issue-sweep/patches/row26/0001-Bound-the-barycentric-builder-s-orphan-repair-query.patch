+++ b/tests/test_1015_custom_mg_orphan_repair_memory.py
@@ -0,0 +1,39 @@
+"""The barycentric builder's orphan repair runs in memory linear in the orphans.
+
+The repair gives each orphan coarse DOF (a column with no fine image) its nearest
+unclaimed fine DOF. It used to query orphans + 8 neighbours for every orphan at
+once, an (orphans x orphans) array: 8.6 GB per rank on #893's hierarchy. The
+fixture forces 1,770 orphans by putting the fine cloud in the left half of the
+coarse one; that query held 55 MB here, the bounded one 4 MB.
+"""
+
+import tracemalloc
+
+import numpy as np
+import pytest
+
+from underworld3.utilities import custom_mg
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
+
+
+def test_orphan_repair_memory_is_bounded():
+    g = np.linspace(0.0, 1.0, 60)
+    coarse = np.array([(x, y) for x in g for y in g])
+    fine = np.random.default_rng(0).random((3600, 2)) * [0.5, 1.0]
+
+    stats = {}
+    tracemalloc.start()
+    try:
+        P = custom_mg.barycentric_prolongation(coarse, fine, stats=stats)
+        peak = tracemalloc.get_traced_memory()[1]
+    finally:
+        tracemalloc.stop()
+
+    assert peak < 20.0e6, f"orphan repair peaked at {peak / 1e6:.1f} MB"
+    # the claims themselves are unchanged (hard baseline, development's builder)
+    assert stats["orphans_repaired"] == 1770
+    assert P.nnz == 7260
+    empty = np.asarray((P != 0).sum(axis=0)).ravel() == 0
+    assert int(empty.sum()) == 877
+    np.testing.assert_allclose(np.asarray(P.sum(axis=1)).ravel(), 1.0, rtol=0, atol=1e-14)
