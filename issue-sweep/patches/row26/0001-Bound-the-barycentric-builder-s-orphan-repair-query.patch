+            if len(fixes) == n_fine:
+                break
+            row, k = cand[i], k0
+            free = ~taken[row]
+            while not free.any():
+                k = min(2 * k, n_fine)
+                row = np.atleast_1d(ftree.query(coarse_coords[c], k=k)[1])
+                free = ~taken[row]
+            f = int(row[np.argmax(free)])
+            taken[f] = True
+            fixes[f] = int(c)
         if fixes:
