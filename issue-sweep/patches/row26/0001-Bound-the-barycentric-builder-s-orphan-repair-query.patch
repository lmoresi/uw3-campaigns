+    n_fine = fine_coords.shape[0]
+    if orphans.size and n_fine:
+        # Each orphan, in order, claims its nearest unclaimed fine DOF. The
+        # query starts at 9 neighbours and doubles, for that orphan only, while
+        # every candidate is already claimed. One query of orphans + 8
+        # neighbours for every orphan gave the same claims but held an
+        # (orphans x orphans) array: 8.6 GB per rank on #893's hierarchy.
+        ftree = cKDTree(fine_coords)
+        k0 = min(9, n_fine)
+        cand = ftree.query(coarse_coords[orphans], k=k0)[1].reshape(orphans.size, k0)
+        taken = np.zeros(n_fine, dtype=bool)
+        fixes = {}
         for i, c in enumerate(orphans):
