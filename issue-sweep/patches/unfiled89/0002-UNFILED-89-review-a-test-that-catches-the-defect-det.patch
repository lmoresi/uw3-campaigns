+def _at_offset(values, offset):
+    """``values`` copied into a buffer ``offset`` doubles past a 64-byte boundary."""
+    buf = np.empty(values.size + 16)
+    base = (-(buf.ctypes.data // 8)) % 8
+    view = buf[base + offset: base + offset + values.size]
+    view[:] = values
+    return view
+
 
+@pytest.mark.parametrize("n", [384, 1536, 20011])
+def test_the_per_rank_sum_does_not_depend_on_where_the_array_sits(n):
+    # random data: dasum of these differs by offset for 89 of 90 vectors on AVX-512
+    values = np.random.default_rng(n).standard_normal(n)
+    sums = {rotated_bc._sum_abs_deterministic(_at_offset(values, k)).hex()
+            for k in range(OFFSETS)}
+    assert len(sums) == 1, sorted(sums)
 
