+def _sum_abs_deterministic(values):
+    """sum |values|, the same bits wherever ``values`` sits in memory (UNFILED 89).
+
+    ``math.fsum`` rounds once, from the exact sum, so neither the summation order
+    nor the array's alignment can move it. BLAS dasum (PETSc's ``NORM_1``) can:
+    on AVX-512 OpenBLAS the same data at different offsets from a 64-byte boundary
+    gives one of two results an ulp apart."""
+    import math
+
+    return math.fsum(np.abs(np.asarray(values)).tolist())
+
+
 def _velocity_diag_scale(Ahat, solver):
     """Mean |diag| of the (rotated) velocity block — the representative diagonal
-    for constraint rows (see the zeroRowsColumns call sites). Collective.
-
-    Bit-identical from run to run (UNFILED 89): each rank's sum is ``math.fsum``
-    (exactly rounded, so independent of order and of where the array sits in
-    memory), and the ranks' sums are gathered and summed the same way. It was
-    ``NORM_1``, which is BLAS dasum, and on AVX-512 OpenBLAS dasum of the same
-    data gives one of two results an ulp apart depending on the array's
-    alignment; getSubVector's array lands somewhere new each call. The ulp went
-    into the eliminated rows' diagonal and moved Krylov round-off: a warm
-    re-solve's pressure sub-solve took 12, 13 or its 200 cap from run to run."""
+    for constraint rows (see the zeroRowsColumns call sites). Collective on
+    ``Ahat``'s communicator.
+
+    Deterministic from run to run at a given rank count (UNFILED 89): each rank's
+    sum is :func:`_sum_abs_deterministic`, and the ranks' sums are gathered on the
+    operator's communicator and summed the same way. (fsum of per-rank fsums,
+    divided by n, rounds more than once, so it is reproducible, not the correctly
+    rounded mean.) It was ``NORM_1``, which is BLAS dasum; on AVX-512 OpenBLAS
+    dasum depends on the array's alignment, and getSubVector's array lands
+    somewhere new each call. The ulp went into the eliminated rows' diagonal and
+    moved Krylov round-off: a warm re-solve's pressure sub-solve took 12, 13 or
+    its 200 cap from run to run."""
     import math
 
     d = Ahat.getDiagonal()
     vis = solver._subdict["velocity"][0]
     sub = d.getSubVector(vis)
     n = sub.getSize()
-    local = math.fsum(np.abs(sub.getArray(readonly=True)).tolist())
+    local = _sum_abs_deterministic(sub.getArray(readonly=True))
     d.restoreSubVector(vis, sub)
     d.destroy()
-    s = math.fsum(mpi.comm.allgather(local)) / max(n, 1)
+    comm = Ahat.getComm().tompi4py()
+    s = math.fsum(comm.allgather(local)) / max(n, 1)
     return float(s) if s > 0.0 else 1.0
 
 
