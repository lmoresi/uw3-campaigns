+# a sample of the trace whose direction changes by more than this is a TURN:
+# it is pulled after the plain samples, and the chain must pass through it
+_TURN_DEG = 45.0
+_TURN_LABEL = "UW_FaultTurn"
+
+
+def _turns(P):
+    """Mask of the samples of ``P`` that are turns (never the tips)."""
+    P = np.asarray(P, dtype=float)
+    out = np.zeros(len(P), dtype=bool)
+    if len(P) > 2:
+        a = P[1:-1] - P[:-2]
+        b = P[2:] - P[1:-1]
+        cos = np.einsum("ij,ij->i", a, b) / (np.linalg.norm(a, axis=1) * np.linalg.norm(b, axis=1))
+        out[1:-1] = np.degrees(np.arccos(np.clip(cos, -1.0, 1.0))) > _TURN_DEG
+    return out
+
+
+def _in_pull_order(P):
+    """The samples of ``P`` in the order add_fault pulls them: the plain samples,
+    then the turns, then the two tips, so a tip or a turn keeps the vertex it
+    shares with a neighbour (the later target keeps it)."""
+    P = np.asarray(P, dtype=float)
+    if len(P) <= 2:
+        return P
+    turn = _turns(P)
+    inner = np.arange(1, len(P) - 1)
+    return np.vstack([P[inner[~turn[inner]]], P[inner[turn[inner]]], P[[0, -1]]])
+
+
+def _mark_turn_vertices(dm, P):
+    """Label the vertices the trace's turns were just pulled onto, matched exactly
+    as the tips are (:func:`_mark_tip_vertices`). A turn that went without its
+    vertex (one shared with a tip) is not labelled."""
+    from underworld3.utilities.line_cut import _coords
+
+    if dm.hasLabel(_TURN_LABEL):
+        dm.removeLabel(_TURN_LABEL)
+    dm.createLabel(_TURN_LABEL)
+    label = dm.getLabel(_TURN_LABEL)
+    X = _coords(dm)
+    vS, _vE = dm.getDepthStratum(0)
+    P = np.asarray(P, dtype=float)
+    for q in P[_turns(P)]:
+        for v in np.flatnonzero(np.all(X == q, axis=1)):
+            label.setValue(int(v) + vS, 1)
+
+
