+def _local_cell_size(X, ends, points):
+    """The mesh's edge length near each of ``points``: the MEDIAN length of the
+    edges whose midpoints lie within three times the distance from the point to
+    the nearest edge midpoint, so it follows a graded mesh (a mean counts the
+    diagonals and the cut's own short edges; on a regular box the median is the
+    cell side). COLLECTIVE: the nearest distance is MIN-reduced into a buffer
+    (mpi4py's pickling allreduce compares whole arrays under MIN), and each
+    rank's nearby lengths are gathered, so every rank takes the same median."""
+    from scipy.spatial import cKDTree
+
+    comm = uw.mpi.comm
+    n = len(points)
+    mid = 0.5 * (X[ends[:, 0]] + X[ends[:, 1]])
+    L = np.linalg.norm(X[ends[:, 0]] - X[ends[:, 1]], axis=1)
+    near = np.full(n, np.inf)
+    tree = cKDTree(mid) if len(mid) else None
+    if tree is not None and n:
+        near = np.asarray(tree.query(points)[0], dtype=float)
+    comm.Allreduce(MPI.IN_PLACE, near, op=MPI.MIN)
+    mine = [np.zeros(0)] * n
+    if tree is not None and n:
+        mine = [L[idx] for idx in tree.query_ball_point(points, r=3.0 * near + 1e-300)]
+    gathered = comm.allgather(mine)
+    out = np.full(n, np.nan)
+    for k in range(n):
+        lens = np.concatenate([g[k] for g in gathered])
+        if lens.size:
+            out[k] = float(np.median(lens))
+    return out
+
