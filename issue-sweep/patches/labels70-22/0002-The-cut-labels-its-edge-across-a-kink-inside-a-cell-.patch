diff --git a/src/underworld3/utilities/line_cut.py b/src/underworld3/utilities/line_cut.py
index 6ba6be56..7d8a74cb 100644
--- a/src/underworld3/utilities/line_cut.py
+++ b/src/underworld3/utilities/line_cut.py
@@ -752,24 +752,79 @@ def _set_coordinates(dm, indices, values):
     dm.setCoordinatesLocal(new)
 
 
+# An edge between two points of a line is the line's when its chord is at least
+# this fraction of the line's length between them. A chord across one kink of
+# turn theta keeps cos(theta / 2) of the arc at worst, so 0.5 admits a kink of
+# up to 120 degrees inside a cell; a hairpin, or two stretches of the line that
+# pass close to each other, give a short chord over a long arc and are refused.
+_CHORD_TO_ARC = 0.5
+
+
+def _segment_length_to(seg, F):
+    """Length along ``seg`` from its start to the points ``F`` on it: along the
+    chord of a planar segment, along the great circle of a spherical one."""
+    if isinstance(seg, _GreatCircleArc):
+        r = np.linalg.norm(seg.A)
+        return r * np.arctan2(np.linalg.norm(np.cross(seg.A, F), axis=1), F @ seg.A)
+    return np.linalg.norm(F - seg.A, axis=1)
+
+
+def _line_parameters(X, line):
+    """Distance of each point to the polyline (as the cut measures it: chords in
+    the plane, great-circle arcs on a sphere), and its arc-length parameter there."""
+    best = np.full(len(X), np.inf)
+    t = np.full(len(X), np.nan)
+    start = 0.0
+    for seg in _segments([line]):
+        F = seg.foot(X)
+        d = np.linalg.norm(X - F, axis=1)
+        closer = d < best
+        best = np.where(closer, d, best)
+        t = np.where(closer, start + _segment_length_to(seg, F), t)
+        start += float(_segment_length_to(seg, seg.B[None, :])[0])
+    return best, t
+
+
 def _label_cut_edges(dm, lines, tol, name, value):
     """Mark the edges lying along the cut; return the edge points marked.
 
-    An edge is on the cut when both its endpoints and its midpoint lie on a line.
-    The midpoint test is what distinguishes the cut from a chord: where a polyline
-    turns, two vertices on different segments can be joined by an edge that is not
-    part of the line at all.
+    An edge is on the cut when, for some line, both its endpoints lie on that
+    line, they are CONSECUTIVE along it (no other vertex on the line lies
+    between their arc-length parameters), and the edge's chord is at least
+    ``_CHORD_TO_ARC`` of the line's length between them. The chord rule is what
+    keeps out an edge that is not part of the line: two vertices of a hairpin, or
+    of two stretches that pass close to each other, are near in space and far
+    along the line. A first rule asked for the edge's MIDPOINT on the line, which
+    also dropped the cut's edge across a kink inside a cell (a sample of the
+    trace with no vertex on it), so a curved surface came back partial or empty
+    (UNFILED 70; UNFILED 22).
 
     The points are returned rather than counted here because a shared edge is held
     by every rank on the seam: counting locally and summing would report it once
-    per sharer. The caller counts the OWNED ones.
+    per sharer. The caller counts the OWNED ones. Consecutiveness is judged among
+    the vertices this rank holds; a vertex between two ends along the line lies
+    in a cell the line passes through between them, which the edge's rank holds.
     """
     X = _coords(dm)
-    on = _distance_to_lines(X, lines) < tol
     eS, _eE = dm.getDepthStratum(1)
     ends = _edge_vertices(dm)
-    mid_on = _distance_to_lines(0.5 * (X[ends[:, 0]] + X[ends[:, 1]]), lines) < tol
-    keep = on[ends[:, 0]] & on[ends[:, 1]] & mid_on
+    keep = np.zeros(len(ends), dtype=bool)
+    for line in lines:
+        d, t = _line_parameters(X, line)
+        on = d < tol
+        both = on[ends[:, 0]] & on[ends[:, 1]] & ~keep
+        if not both.any():
+            continue
+        cand = np.flatnonzero(both)
+        ta, tb = t[ends[cand, 0]], t[ends[cand, 1]]
+        lo, hi = np.minimum(ta, tb), np.maximum(ta, tb)
+        arc = hi - lo
+        chord = np.linalg.norm(X[ends[cand, 0]] - X[ends[cand, 1]], axis=1)
+        ts = np.sort(t[on])
+        between = (np.searchsorted(ts, hi - tol, side="left")
+                   - np.searchsorted(ts, lo + tol, side="right"))
+        ok = (between <= 0) & (chord >= _CHORD_TO_ARC * arc - tol)
+        keep[cand[ok]] = True
 
     if not dm.hasLabel(name):
         dm.createLabel(name)
