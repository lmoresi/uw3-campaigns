diff --git a/tests/test_0898_cut_labels_the_chord_across_a_kink.py b/tests/test_0898_cut_labels_the_chord_across_a_kink.py
new file mode 100644
index 00000000..f9f8dfee
--- /dev/null
+++ b/tests/test_0898_cut_labels_the_chord_across_a_kink.py
@@ -0,0 +1,89 @@
+"""The cut labels its edge across a kink of the trace inside a cell (UNFILED 70, UNFILED 22).
+
+The cut labels an edge as the surface's when both its ends lie on the trace. It used to
+ask for the edge's midpoint on the trace as well, to keep out an edge joining two points of
+the trace across a turn. That also dropped the cut's own edge across a kink of the trace
+inside a cell, where a sample has no vertex: a curved surface added with
+add_conforming_surface came back partial (an arc of turn 0.08 rad: 5 of 17 edges labelled)
+or with no facet at all, and said nothing. The rule now asks for the two ends to be
+consecutive along the trace, with the edge's chord at least half the trace's length between
+them, which still keeps out the two arms of a hairpin.
+
+The assertions are relations on the result (the chain covers the trace; no labelled edge
+spans more than twice its length of trace), not counts from one mesher.
+"""
+
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities import line_cut
+from underworld3.utilities.fault_split import _refuse_an_empty_or_partial_cut
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
+
+H = 1 / 12
+
+
+@pytest.fixture(scope="module")
+def box():
+    return uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                             cellSize=H, regular=True)
+
+
+def _chain(child, name):
+    b = [bb for bb in child.boundaries if bb.name == name][0]
+    dm = child.dm
+    vS, _ = dm.getDepthStratum(0)
+    X = np.asarray(dm.getCoordinatesLocal().array).reshape(-1, 2)
+    lab = dm.getLabel(name)
+    ends = np.array([dm.getCone(int(e)) for e in lab.getStratumIS(b.value).getIndices()]) - vS
+    return b.value, X, ends
+
+
+def _spans(X, ends, trace):
+    """Length of trace between each labelled edge's ends, over the edge's length."""
+    _d, t = line_cut._line_parameters(X, trace)
+    chord = np.linalg.norm(X[ends[:, 0]] - X[ends[:, 1]], axis=1)
+    return np.abs(t[ends[:, 0]] - t[ends[:, 1]]) / chord
+
+
+def _arc():
+    """A gentle arc (turn -0.08 rad) crossing the box, sampled a cell apart: every
+    sample inside a cell is a kink with no vertex on it."""
+    rng = np.random.default_rng(22)
+    for k in range(2):
+        ang = rng.uniform(0, np.pi)
+        turn = rng.uniform(-1, 1) if k % 2 else 0.0
+        c = 0.5 + rng.uniform(-0.05, 0.05, 2)
+    L = 1.6
+    s = np.linspace(-L / 2, L / 2, int(round(L / H)) + 1)
+    th = ang + turn * s / L
+    d = np.column_stack([np.cos(th), np.sin(th)])
+    return c + np.cumsum(np.vstack([[0, 0], d[1:] * np.diff(s)[:, None]]), axis=0) - L / 2 * d[0]
+
+
+def test_a_curved_surface_is_labelled_along_its_whole_length(box):
+    trace = _arc()
+    child = box.add_conforming_surface(uw.meshing.Surface("Arc", box, trace))
+    value, X, ends = _chain(child, "Arc")
+    inside = np.all((trace >= 0) & (trace <= 1), axis=1)
+    # within half a cell of every point of the trace inside the box (the check UNFILED 68
+    # added to add_fault); the midpoint rule left the last 8 cells unlabelled
+    _refuse_an_empty_or_partial_cut(child.dm, "Arc", value, trace[inside])
+    assert (_spans(X, ends, trace) <= 2.0).all()
+
+
+def test_no_edge_joins_the_arms_of_a_hairpin(box):
+    gap = 0.5 * H
+    a = np.linspace(0.0, 0.7, 60)
+    psi = np.linspace(np.pi / 2, -np.pi / 2, 30)[1:-1]
+    trace = np.vstack([np.column_stack([0.52 - a[::-1], np.full(60, 0.5 + gap / 2)]),
+                       np.column_stack([0.52 + gap / 2 * np.cos(psi), 0.5 + gap / 2 * np.sin(psi)]),
+                       np.column_stack([0.52 - a, np.full(60, 0.5 - gap / 2)])])
+    try:
+        child = box.add_conforming_surface(uw.meshing.Surface("Pin", box, trace))
+    except (ValueError, RuntimeError):
+        return                      # refused is acceptable; a spurious edge is not
+    _value, X, ends = _chain(child, "Pin")
+    assert (_spans(X, ends, trace) <= 2.0).all()
