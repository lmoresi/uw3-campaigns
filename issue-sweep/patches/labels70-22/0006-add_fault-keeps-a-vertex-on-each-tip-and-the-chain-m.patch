+@pytest.mark.parametrize("k", [3, 4], ids=["was_empty", "was_short"])
+def test_a_trace_that_came_back_short_is_split_whole(box, k):
+    # measured: one piece each, 0.081 and 0 cells from the trace
+    Q = _trace(k, 0.3)
+    X, E = _plus_chain(box.add_fault(("F", Q)))
+    V = X[np.unique(E.ravel())]
+    for tip in (Q[0], Q[-1]):
+        assert np.linalg.norm(V - tip, axis=1).min() < 1e-12
+    dense = np.vstack([Q[:-1] + x * (Q[1:] - Q[:-1]) for x in np.linspace(0, 1, 11)])
+    d = np.full(len(dense), np.inf)
+    for a, c in zip(X[E[:, 0]], X[E[:, 1]]):
+        e = c - a
+        u = np.clip(((dense - a) @ e) / (e @ e), 0, 1)
+        d = np.minimum(d, np.linalg.norm(dense - (a + u[:, None] * e), axis=1))
+    assert d.max() < 0.25 * H
 
 
