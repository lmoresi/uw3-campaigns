+def _plus_chain(m2):
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+    dm = m2.dm
+    X = _coords(dm)
+    ends = _edge_vertices(dm)
+    eS, _ = dm.getDepthStratum(1)
+    b = [bb for bb in m2.boundaries if bb.name == "FPlus"][0]
+    mk = np.asarray(dm.getLabel("FPlus").getStratumIS(b.value).getIndices()) - eS
+    mk = mk[(mk >= 0) & (mk < len(ends))]
+    return X, ends[mk]
+
