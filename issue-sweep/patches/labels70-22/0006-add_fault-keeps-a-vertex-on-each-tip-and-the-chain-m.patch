+def _mark_tip_vertices(dm, tips):
+    """Label the vertices the trace's tips were just pulled onto. The pull writes
+    a tip's coordinates into its vertex, so they are the stored value itself,
+    matched exactly; the cut carries the label to the same vertex."""
+    from underworld3.utilities.line_cut import _coords
+
+    if dm.hasLabel(_TIP_LABEL):
+        dm.removeLabel(_TIP_LABEL)
+    dm.createLabel(_TIP_LABEL)
+    label = dm.getLabel(_TIP_LABEL)
+    X = _coords(dm)
+    vS, _vE = dm.getDepthStratum(0)
+    for tip in np.asarray(tips, dtype=float):
+        for v in np.flatnonzero(np.all(X == tip, axis=1)):
+            label.setValue(int(v) + vS, 1)
+
