@@ -0,0 +1,61 @@
+"""The cut refuses to leave a degenerate (flat) cell (UNFILED 72).
+
+The cut refused an INVERTED cell, but not a flat one: with few samples of a trace pulled
+onto vertices, a 90-degree turn on the regular 1/12 box left two cells of area 1e-16 of
+their own size, and the cut returned them as if complete. A flat cell gives the
+finite-element map a zero Jacobian. The cut now refuses a cell whose area is below 1e-9 of
+its longest edge squared, naming where it is and the turn of the trace near it. The flat
+cells measured sit below 1e-14 and every sound mesh at 5.7e-5 or above; the threshold is in
+that gap.
+
+The trace and the samples pulled onto vertices are the measured case (spacing half a cell,
+a 90-degree turn). Pulling every sample, as add_fault does, leaves the same kind of cell:
+there add_fault returned a mesh with a 0-degree angle.
+"""
+
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities import line_cut
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
+
+TRACE = np.array([
+    [0.6090432512341917, 0.6609578307168709], [0.5728503003912726, 0.6403136688207525],
+    [0.5366573495483534, 0.619669506924634], [0.5004643987054342, 0.5990253450285156],
+    [0.4642714478625152, 0.5783811831323971], [0.428078497019596, 0.5577370212362787],
+    [0.44872265891571445, 0.5215440703933595], [0.4693668208118329, 0.48535111955044036],
+    [0.49001098270795135, 0.44915816870752123], [0.5106551446040698, 0.41296521786460205],
+    [0.5312993065001882, 0.3767722670216829]])
+PULLED = TRACE[[0, 2, 3, 4, 5, 6, 7, 8, 10]]
+
+
+@pytest.fixture(scope="module")
+def box():
+    return uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                             cellSize=1 / 12, regular=True)
+
+
+def test_a_flat_cell_is_refused_and_located(box):
+    dm = line_cut.pull_vertex_onto(box.dm, PULLED, on_shared="note")
+    with pytest.raises(RuntimeError, match="flat cell") as err:
+        line_cut.cut_along_lines(dm, [TRACE])
+    msg = str(err.value)
+    assert "the trace turns 90 degrees" in msg and "sample the trace" in msg, msg
+
+
+def test_every_sample_pulled_is_refused_too(box):
+    # the flat cells come from the cut, not from which samples are pulled: with every
+    # sample pulled, as add_fault does, five samples lose their vertex to a later one
+    # and the cut leaves the same kind of cell (add_fault returned it, a 0-degree angle)
+    dm = line_cut.pull_vertex_onto(box.dm, TRACE, on_shared="note")
+    with pytest.raises(RuntimeError, match="flat cell"):
+        line_cut.cut_along_lines(dm, [TRACE])
+
+
+def test_a_trace_that_places_is_not_refused(box):
+    line = np.array([[0.2 + 0.1 * k, 0.43 + 0.02 * k] for k in range(7)])
+    dm = line_cut.pull_vertex_onto(box.dm, line, on_shared="note")
+    _cut, info = line_cut.cut_along_lines(dm, [line])
+    assert info["min_angle"] > 1.0
