diff --git a/src/underworld3/utilities/line_cut.py b/src/underworld3/utilities/line_cut.py
index 7d8a74cb..e601c005 100644
--- a/src/underworld3/utilities/line_cut.py
+++ b/src/underworld3/utilities/line_cut.py
@@ -860,6 +860,68 @@ def cell_areas(dm, global_vote=False):
     return 0.5 * _signed_twice_areas(P, _global_flip(P, dm.getComm()) if global_vote else None)
 
 
+# A cut cell is FLAT when its area is below this fraction of its own longest
+# edge squared (0.433 for an equilateral cell). It is a flatness guard, not a
+# quality guard: a flat cell gives the finite-element map a zero Jacobian, and
+# the inverted-cell check above misses it. Measured over every mesh add_fault
+# returned in UNFILED 72's hunt (about 1060 meshes, three pull rules), the flat
+# ones sit below 1e-14 (round-off) and the sound ones at 5.7e-5 and above
+# (development's worst; nearly all at 1e-2 and above), with nothing between. The
+# threshold is the log-middle of that gap. Being relative to the cell's own
+# size, it reads alike on a graded mesh. A poor but not flat cell (development
+# returns one at 5.7e-5) passes; a quality limit would be a separate decision.
+_DEGENERATE_AREA_FRACTION = 1.0e-9
+
+
+def _refuse_degenerate_cells(dm, areas, lines):
+    """Raise on every rank when the cut leaves a degenerate cell, naming the worst
+    cell and the turn of the trace nearest it. COLLECTIVE."""
+    X = _coords(dm)
+    vS, vE = dm.getDepthStratum(0)
+    cS, cE = dm.getHeightStratum(0)
+    worst = (np.inf, np.inf, *([np.inf] * X.shape[1]))
+    n_bad = 0
+    for c in range(cS, cE):
+        v = [int(p) - vS for p in dm.getTransitiveClosure(c)[0] if vS <= p < vE]
+        P = X[v]
+        longest = max(np.linalg.norm(P[i] - P[j]) for i, j in ((0, 1), (1, 2), (2, 0)))
+        ratio = abs(float(areas[c - cS])) / (longest * longest) if longest > 0 else 0.0
+        if ratio < _DEGENERATE_AREA_FRACTION:
+            n_bad += 1
+            if ratio < worst[0]:
+                worst = (ratio, float(longest), *P.mean(axis=0))
+    n_bad = uw.mpi.comm.allreduce(n_bad, op=MPI.SUM)
+    if not n_bad:
+        return
+    ratio, size, *where = uw.mpi.comm.allreduce(worst, op=MPI.MIN)
+    where = np.array(where)
+    # the trace's nearest sample, and its sharpest turn within three of the
+    # worst cell's longest edge (the same on every rank: lines are replicated)
+    near_d, near_p, sharp = np.inf, None, (0.0, None)
+    for line in lines:
+        L = np.asarray(line, dtype=float)
+        for i in range(len(L)):
+            d = float(np.linalg.norm(L[i] - where))
+            if d < near_d:
+                near_d, near_p = d, L[i]
+            if 0 < i < len(L) - 1 and d <= 3.0 * size:
+                a, b = L[i] - L[i - 1], L[i + 1] - L[i]
+                cos = float(a @ b) / (np.linalg.norm(a) * np.linalg.norm(b))
+                turn = float(np.degrees(np.arccos(np.clip(cos, -1.0, 1.0))))
+                if turn > sharp[0]:
+                    sharp = (turn, L[i])
+    fmt = lambda q: tuple(round(float(x), 6) for x in q)
+    turn_text = (f"; the trace turns {sharp[0]:.0f} degrees at {fmt(sharp[1])}, "
+                 f"within three cells of it" if sharp[1] is not None and sharp[0] > 10.0
+                 else "; the trace runs straight there")
+    raise RuntimeError(
+        f"the cut leaves {n_bad} flat cell(s) (area below "
+        f"{_DEGENERATE_AREA_FRACTION:g} of the cell's longest edge squared), the "
+        f"worst at {fmt(where)}, beside the trace's sample at {fmt(near_p)}"
+        f"{turn_text}. Give a sharp turn a vertex of its own (sample the trace at "
+        f"it), reduce its angle, or resample the trace near it about a cell apart.")
+
+
 def min_angles(dm):
     """Smallest interior angle of every triangle, in degrees.
 
@@ -1143,6 +1205,8 @@ def cut_along_lines(dm, lines, snap_frac=0.10, label=CUT_LABEL, label_value=1,
             f"snapping inverted {n_inverted} cell(s); snap_frac={snap_frac} is "
             "too large for this mesh.")
 
+    _refuse_degenerate_cells(cut, areas, lines)
+
     marked = _label_cut_edges(cut, lines, 1e-9 * scale, label, label_value)
 
