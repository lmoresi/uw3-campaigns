@@ -0,0 +1,101 @@
+"""add_fault's empty-or-partial refusal in parallel (UNFILED 68).
+
+The refusal is collective: every count and distance is reduced, the cell size is
+taken from the k nearest owned base-mesh edges gathered over the ranks, and the
+chain's pieces are joined at global vertex numbers over the gathered labelled
+edges. So every rank raises the same message or none does, and a chain that
+crosses a partition seam counts as one piece.
+
+What is asserted, at any rank count:
+
+* the two traces of tests/test_0897 that cut short are refused on every rank,
+  with one message, and the whole one is added on every rank;
+* a chain labelled by hand along y = 0.5 across most of the distributed box is
+  one piece and passes; the same chain with one edge left out is refused as two
+  pieces on every rank.
+
+    mpirun -n 2 python -m pytest --with-mpi tests/parallel/test_0897_add_fault_refusal_agrees_across_ranks_parallel.py
+    mpirun -n 3 python -m pytest --with-mpi tests/parallel/test_0897_add_fault_refusal_agrees_across_ranks_parallel.py
+"""
+import numpy as np
+import pytest
+
+import underworld3 as uw
+
+pytestmark = [pytest.mark.mpi(min_size=2), pytest.mark.level_2, pytest.mark.tier_b,
+              pytest.mark.timeout(900)]
+
+H = 1 / 12
+
+
+def _trace(k, ds):
+    # the generator of tests/test_0897
+    rng = np.random.default_rng(22)
+    for i in range(k + 1):
+        ang = rng.uniform(0, np.pi)
+        turn = rng.uniform(-1, 1) if i % 2 else 0.0
+        c = 0.5 + rng.uniform(-0.05, 0.05, 2)
+    L = 6 * H
+    s = np.linspace(-L / 2, L / 2, max(2, int(round(6 / ds))) + 1)
+    th = ang + turn * s / L
+    d = np.column_stack([np.cos(th), np.sin(th)])
+    return c + np.cumsum(np.vstack([[0, 0], d[1:] * np.diff(s)[:, None]]), axis=0) - L / 2 * d[0]
+
+
+@pytest.fixture(scope="module")
+def box():
+    return uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                             cellSize=H, regular=True)
+
+
+def _outcome(fn):
+    try:
+        fn()
+        return "passed"
+    except ValueError as e:
+        return str(e)
+
+
+def _same_everywhere(outcome):
+    every = uw.mpi.comm.allgather(outcome)
+    assert all(o == every[0] for o in every), every
+    return every[0]
+
+
+@pytest.mark.parametrize("k", [3, 4], ids=["empty", "short"])
+def test_a_short_cut_is_refused_alike_on_every_rank(box, k):
+    out = _same_everywhere(_outcome(lambda: box.add_fault(("F", _trace(k, 0.3)))))
+    assert "misses part of the trace" in out or "labelled no facet" in out
+
+
+def test_a_whole_cut_is_added_on_every_rank(box):
+    assert _same_everywhere(_outcome(lambda: box.add_fault(("F", _trace(0, 1.0))))) == "passed"
+
+
+def _label_on_y(dm, name, y, spans):
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+    X = _coords(dm)
+    eS, _ = dm.getDepthStratum(1)
+    ends = _edge_vertices(dm)
+    lo = np.minimum(X[ends[:, 0], 0], X[ends[:, 1], 0])
+    hi = np.maximum(X[ends[:, 0], 0], X[ends[:, 1], 0])
+    on = (np.abs(X[ends[:, 0], 1] - y) < 1e-9) & (np.abs(X[ends[:, 1], 1] - y) < 1e-9)
+    keep = np.zeros(len(ends), dtype=bool)
+    for x0, x1 in spans:
+        keep |= on & (lo >= x0 - 1e-9) & (hi <= x1 + 1e-9)
+    dm.createLabel(name)
+    lab = dm.getLabel(name)
+    for e in np.flatnonzero(keep) + eS:
+        lab.setValue(int(e), 7)
+
+
+def test_a_chain_across_the_seams_is_one_piece(box):
+    from underworld3.utilities.fault_split import _refuse_an_empty_or_partial_cut
+    poly = np.array([[1 / 12, 0.5], [11 / 12, 0.5]])
+    dm = box.dm.clone()
+    _label_on_y(dm, "Whole", 0.5, [(1 / 12, 11 / 12)])
+    assert _same_everywhere(_outcome(lambda: _refuse_an_empty_or_partial_cut(dm, "Whole", 7, poly))) == "passed"
+    dm = box.dm.clone()
+    _label_on_y(dm, "Gap", 0.5, [(1 / 12, 6 / 12), (7 / 12, 11 / 12)])
+    out = _same_everywhere(_outcome(lambda: _refuse_an_empty_or_partial_cut(dm, "Gap", 7, poly)))
+    assert "is in 2 pieces" in out
