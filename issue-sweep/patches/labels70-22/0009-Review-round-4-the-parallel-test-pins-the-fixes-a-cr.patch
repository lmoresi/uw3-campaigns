+def test_a_crossing_of_an_unrecorded_fault_is_named(box):
+    """The sides of a fault this mesh does not record as split (a mesh read back
+    from a file carries the labels, not the record): a chain cut in two there is
+    refused as a crossing, not with advice to resample."""
+    from underworld3.utilities.fault_split import _refuse_an_empty_or_partial_cut
+    poly = np.array([[0.25, 0.5], [0.75, 0.5]])
+    dm = box.dm.clone()
+    # the first piece ends ON the old fault (x = 1/2), as a chain cut by its slit does
+    _label_edges_on_y(dm, "Gap", 0.5, 0.25, 0.5)
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+    X = _coords(dm)
+    eS, _ = dm.getDepthStratum(1)
+    ends = _edge_vertices(dm)
+    lab = dm.getLabel("Gap")
+    for e in np.flatnonzero((np.abs(X[ends[:, 0], 1] - 0.5) < 1e-9) & (np.abs(X[ends[:, 1], 1] - 0.5) < 1e-9)
+                            & (np.minimum(X[ends[:, 0], 0], X[ends[:, 1], 0]) >= 7 / 12 - 1e-9)
+                            & (np.maximum(X[ends[:, 0], 0], X[ends[:, 1], 0]) <= 0.75 + 1e-9)) + eS:
+        lab.setValue(int(e), 7)
+    # the old fault's two sides, on the vertical row of edges at x = 1/2 through the gap
+    for side in ("OldPlus", "OldMinus"):
+        dm.createLabel(side)
+        on = ((np.abs(X[ends[:, 0], 0] - 0.5) < 1e-9) & (np.abs(X[ends[:, 1], 0] - 0.5) < 1e-9)
+              & (np.minimum(X[ends[:, 0], 1], X[ends[:, 1], 1]) >= 0.25 - 1e-9)
+              & (np.maximum(X[ends[:, 0], 1], X[ends[:, 1], 1]) <= 0.75 + 1e-9))
+        for e in np.flatnonzero(on) + eS:
+            dm.getLabel(side).setValue(int(e), 1)
+    with pytest.raises(ValueError, match="crosses or touches the sides of an existing fault"):
+        _refuse_an_empty_or_partial_cut(dm, "Gap", 7, poly)
