+def _a_seam_edge_on_a_row(dm):
+    """A row y = k/12 and an edge of it held by two ranks (a ghost on one of
+    them), from the actual partition; the same answer on every rank."""
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+    if uw.mpi.size == 1:
+        return None
+    X = _coords(dm)
+    ends = _edge_vertices(dm)
+    eS, eE = dm.getDepthStratum(1)
+    _nroots, leaves, _remote = dm.getPointSF().getGraph()
+    ghost = {int(p) - eS for p in (leaves if leaves is not None else []) if eS <= int(p) < eE}
+    mine = []
+    for e in sorted(ghost):
+        a, c = X[ends[e, 0]], X[ends[e, 1]]
+        if abs(a[1] - c[1]) < 1e-9 and 2 / 12 - 1e-9 < a[1] < 10 / 12 + 1e-9:
+            lo, hi = sorted((float(a[0]), float(c[0])))
+            if lo > 3 / 12 - 1e-9 and hi < 11 / 12 + 1e-9:
+                mine.append((float(a[1]), lo, hi))
+    every = sorted({t for found in uw.mpi.comm.allgather(mine) for t in found})
+    return every[0] if every else None
