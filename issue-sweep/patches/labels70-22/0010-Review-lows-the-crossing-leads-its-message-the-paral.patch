+def _on_the_chain(m2, points):
+    """For each point, whether it is a vertex of the fault's Plus chain on some
+    rank: reduced, so the same answer on every rank."""
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+    dm = m2.dm
+    X = _coords(dm)
+    ends = _edge_vertices(dm)
+    eS, _ = dm.getDepthStratum(1)
+    b = [bb for bb in m2.boundaries if bb.name == "FPlus"][0]
+    lab = dm.getLabel("FPlus")
+    mine = np.zeros(len(points), dtype=np.int64)
+    if lab is not None and lab.getStratumSize(b.value):
+        mk = np.asarray(lab.getStratumIS(b.value).getIndices()) - eS
+        mk = mk[(mk >= 0) & (mk < len(ends))]
+        V = X[np.unique(ends[mk].ravel())]
+        if len(V):
+            mine = np.array([int(np.linalg.norm(V - p, axis=1).min() < 1e-12) for p in points])
+    uw.mpi.comm.Allreduce(MPI.IN_PLACE, mine, op=MPI.MAX)
+    return mine.tolist()
+
