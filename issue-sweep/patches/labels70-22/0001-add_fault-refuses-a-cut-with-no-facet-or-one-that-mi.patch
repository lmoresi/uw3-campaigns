--- /dev/null
+++ b/tests/test_0897_add_fault_refuses_an_empty_or_partial_cut.py
@@ -0,0 +1,94 @@
+"""add_fault refuses a cut that labels no facet, or a chain that misses part of the trace (UNFILED 68).
+
+The cut labels an edge only when both its ends and its midpoint lie on the trace. A trace
+sampled finer than the mesh can leave a sample without a vertex, and the edge joining its
+neighbours is then a chord, not on the trace, and unlabelled. add_fault used to return such
+a fault with no facet at all, or with a chain that stopped short of the trace's end, and say
+nothing. On an irregular 1/12 box, 8 of 40 smooth traces sampled 0.3 cells apart came back
+with no facet.
+
+The traces here are on the regular 1/12 box: six cells long, sampled 0.3 cells apart, from
+the measurement's generator. One comes back empty, one stops 0.6 cells short of its end, and
+one sampled a cell apart is whole and must still be added.
+"""
+
+import numpy as np
+import pytest
+
+import underworld3 as uw
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
+
+H = 1 / 12
+
+
+def _trace(k, ds):
+    rng = np.random.default_rng(22)
+    for i in range(k + 1):
+        ang = rng.uniform(0, np.pi)
+        turn = rng.uniform(-1, 1) if i % 2 else 0.0
+        c = 0.5 + rng.uniform(-0.05, 0.05, 2)
+    L = 6 * H
+    s = np.linspace(-L / 2, L / 2, max(2, int(round(6 / ds))) + 1)
+    th = ang + turn * s / L
+    d = np.column_stack([np.cos(th), np.sin(th)])
+    return c + np.cumsum(np.vstack([[0, 0], d[1:] * np.diff(s)[:, None]]), axis=0) - L / 2 * d[0]
+
+
+@pytest.fixture(scope="module")
+def box():
+    return uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                             cellSize=H, regular=True)
+
+
+def test_a_cut_with_no_facet_is_refused(box):
+    with pytest.raises(ValueError, match="labelled no facet") as err:
+        box.add_fault(("F", _trace(3, 0.3)))
+    assert "resample the trace" in str(err.value)
+
+
+def test_a_chain_that_stops_short_is_refused(box):
+    with pytest.raises(ValueError, match="misses part of the trace") as err:
+        box.add_fault(("F", _trace(4, 0.3)))
+    assert "resample the trace" in str(err.value)
+
+
+def test_a_whole_cut_is_added(box):
+    m2 = box.add_fault(("F", _trace(0, 1.0)))
+    b = [bb for bb in m2.boundaries if bb.name == "F"][0]
+    assert m2.dm.getLabel("F").getStratumSize(b.value) > 0
+
+
+def _label_edges_on_y(dm, name, y, x0, x1):
+    """Label the mesh edges lying on the line y = const between x0 and x1."""
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+    X = _coords(dm)
+    eS, _ = dm.getDepthStratum(1)
+    ends = _edge_vertices(dm)
+    tol = 1e-9
+    on = ((np.abs(X[ends[:, 0], 1] - y) < tol) & (np.abs(X[ends[:, 1], 1] - y) < tol)
+          & (np.minimum(X[ends[:, 0], 0], X[ends[:, 1], 0]) >= x0 - tol)
+          & (np.maximum(X[ends[:, 0], 0], X[ends[:, 1], 0]) <= x1 + tol))
+    dm.createLabel(name)
+    lab = dm.getLabel(name)
+    for e in np.flatnonzero(on) + eS:
+        lab.setValue(int(e), 7)
+    return int(on.sum())
+
+
+def test_the_check_on_chains_labelled_by_hand(box):
+    """The check itself, on a straight trace along the box's row of edges at y = 0.5,
+    independent of how any mesher places a cut."""
+    from underworld3.utilities.fault_split import _refuse_an_empty_or_partial_cut
+    poly = np.array([[0.25, 0.5], [0.75, 0.5]])
+    dm = box.dm.clone()
+    dm.createLabel("E")
+    with pytest.raises(ValueError, match="labelled no facet"):
+        _refuse_an_empty_or_partial_cut(dm, "E", 7, poly)
+    dm = box.dm.clone()
+    assert _label_edges_on_y(dm, "Half", 0.5, 0.25, 0.5) > 0
+    with pytest.raises(ValueError, match="misses part of the trace"):
+        _refuse_an_empty_or_partial_cut(dm, "Half", 7, poly)
+    dm = box.dm.clone()
+    assert _label_edges_on_y(dm, "Whole", 0.5, 0.25, 0.75) > 0
+    _refuse_an_empty_or_partial_cut(dm, "Whole", 7, poly)
