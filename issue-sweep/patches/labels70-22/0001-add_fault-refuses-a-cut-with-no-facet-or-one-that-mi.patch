diff --git a/src/underworld3/utilities/fault_split.py b/src/underworld3/utilities/fault_split.py
index 4cbd4dec..69bfe90d 100644
--- a/src/underworld3/utilities/fault_split.py
+++ b/src/underworld3/utilities/fault_split.py
@@ -1611,6 +1611,63 @@ def _label_embedded_edges(dm, segments, values, exclude=None, verbose=False,
     return new
 
 
+def _refuse_an_empty_or_partial_cut(dm, name, value, poly):
+    """Refuse a cut whose chain labels no facet, or misses part of the trace (UNFILED 68).
+
+    The cut labels an edge only when both its ends and its midpoint lie on the
+    trace, so a sample left without a vertex (a trace sampled finer than the
+    mesh) leaves the chord between its neighbours unlabelled: the fault came
+    back with no facet, or stopping short of the trace's end, and nothing said
+    so. The chain must come within half a cell of every point of the trace
+    (the trace is sampled at ten points per segment); the cell is the mean edge
+    length within the trace's bounding box, grown by a tenth of its diagonal.
+    COLLECTIVE: the counts and distances are reduced, so every rank decides
+    alike."""
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+
+    comm = uw.mpi.comm
+    X = _coords(dm)
+    eS, _eE = dm.getDepthStratum(1)
+    ends = _edge_vertices(dm)
+    lab = dm.getLabel(name)
+    marked = (np.asarray(lab.getStratumIS(int(value)).getIndices(), dtype=np.int64) - eS
+              if lab is not None and lab.getStratumSize(int(value)) else
+              np.zeros(0, dtype=np.int64))
+    n_facets = int(comm.allreduce(int(marked.size), op=MPI.SUM))
+
+    lo, hi = poly.min(axis=0), poly.max(axis=0)
+    grow = 0.1 * float(np.linalg.norm(hi - lo))
+    mid = 0.5 * (X[ends[:, 0]] + X[ends[:, 1]])
+    near = np.all((mid >= lo - grow) & (mid <= hi + grow), axis=1)
+    lengths = np.linalg.norm(X[ends[near, 0]] - X[ends[near, 1]], axis=1)
+    tot = comm.allreduce(np.array([lengths.sum(), lengths.size], dtype=float), op=MPI.SUM)
+    h = float(tot[0] / tot[1]) if tot[1] else float("nan")
+    seg = np.linalg.norm(np.diff(poly, axis=0), axis=1)
+    spacing = float(np.median(seg)) if seg.size else float("nan")
+    advice = (f"The trace's samples are {spacing:.3g} apart (median), against cells "
+              f"of about {h:.3g} here; resample the trace to about one cell "
+              f"({h:.3g}) apart and add the fault again.")
+    if n_facets == 0:
+        raise ValueError(f"add_fault: the cut along {name!r} labelled no facet, so "
+                         f"there would be no fault. {advice}")
+
+    t = np.linspace(0.0, 1.0, 11)
+    dense = np.vstack([poly[:-1] + x * (poly[1:] - poly[:-1]) for x in t])
+    d = np.full(len(dense), np.inf)
+    for a, b in zip(X[ends[marked, 0]], X[ends[marked, 1]]):
+        e = b - a
+        L = float(e @ e)
+        u = np.clip(((dense - a) @ e) / L, 0.0, 1.0) if L > 0 else np.zeros(len(dense))
+        d = np.minimum(d, np.linalg.norm(dense - (a + u[:, None] * e), axis=1))
+    d = comm.allreduce(d, op=MPI.MIN)
+    worst = int(np.argmax(d))
+    if d[worst] > 0.5 * h:
+        where = tuple(float(x) for x in dense[worst])
+        raise ValueError(f"add_fault: the cut along {name!r} misses part of the trace: "
+                         f"the labelled chain is {d[worst]:.3g} from the trace at {where}, "
+                         f"more than half a cell ({0.5 * h:.3g}). {advice}")
+
+
 def add_fault(mesh, faults, verbose=False, cut=True, exclude=None,
               blind=1, across_seams=False, partition=True, on_shared="warn",
               **place_kwargs):
@@ -1785,6 +1842,8 @@ def add_fault(mesh, faults, verbose=False, cut=True, exclude=None,
             n_shared += line_cut_module.last_shared_targets["count"]
             dm, info = cut_along_lines(dm, [poly], label=name,
                                        label_value=values[name], **snap)
+            _refuse_an_empty_or_partial_cut(dm, name, values[name],
+                                            np.asarray(poly, dtype=float))
             if verbose:
                 uw.pprint(f"[add_fault {name!r}] {info['n_cut_edges']} "
                           f"facets, min angle {info['min_angle']:.2f} deg")
