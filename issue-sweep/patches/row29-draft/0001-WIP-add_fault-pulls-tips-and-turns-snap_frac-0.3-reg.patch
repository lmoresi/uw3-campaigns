index 00000000..2d26b7a7
--- /dev/null
+++ b/tests/test_0900_add_fault_slip_independent_of_sampling.py
@@ -0,0 +1,67 @@
+"""add_fault places a finely sampled trace, and the answer does not depend on the sampling (row 29).
+
+add_fault pulled a mesh vertex onto every sample of the trace. A trace sampled finer than
+the mesh then distorted the cells until the cut's snap inverted them, or two samples shared
+a vertex and the chain broke: this arc, sampled a third or half of a cell apart, was refused
+("snapping inverted 3 cell(s)", "the chain has a single facet") and sampled a cell apart came
+back partial. The fault's slip in a sheared box also depended on the sampling: pulling a vertex
+onto every sample makes the mesh follow it (up to 8 % in the measurement). add_fault now pulls
+the trace's two tips, its turns of more than 45 degrees, and its samples within one and a half
+cells of a turn of more than 90 degrees; the cut follows the whole trace between them.
+
+The assertions are relations on one mesh: every sampling places the fault, and the slips agree.
+"""
+
+import numpy as np
+import pytest
+
+import underworld3 as uw
+
+pytestmark = [pytest.mark.level_2, pytest.mark.tier_b]
+
+H = 1 / 12
+
+
+def _arc(ds):
+    """A gentle arc (the measurement's trace la1), six cells long, sampled ds cells apart."""
+    rng = np.random.default_rng(22)
+    for k in range(2):
+        ang = rng.uniform(0, np.pi)
+        turn = rng.uniform(-1, 1) if k % 2 else 0.0
+        c = 0.5 + rng.uniform(-0.05, 0.05, 2)
+    L = 6 * H
+    s = np.linspace(-L / 2, L / 2, 400)
+    th = ang + turn * s / L
+    d = np.column_stack([np.cos(th), np.sin(th)])
+    P = c + np.cumsum(np.vstack([[0, 0], d[1:] * np.diff(s)[:, None]]), axis=0) - L / 2 * d[0]
+    seg = np.linalg.norm(np.diff(P, axis=0), axis=1)
+    cum = np.concatenate([[0], np.cumsum(seg)])
+    q = np.linspace(0, cum[-1], int(round(cum[-1] / (ds * H))) + 1)
+    return np.column_stack([np.interp(q, cum, P[:, 0]), np.interp(q, cum, P[:, 1])])
+
+
+def _slip(mesh):
+    x, y = mesh.X
+    st = uw.systems.Stokes(mesh)
+    st.constitutive_model = uw.constitutive_models.ViscousFlowModel
+    st.constitutive_model.Parameters.shear_viscosity_0 = 1
+    st.tolerance = 1.0e-8
+    st.petsc_use_pressure_nullspace = True
+    for side in ("Top", "Bottom", "Left", "Right"):
+        st.add_dirichlet_bc((y - 0.5, 0.0), side)
+    st.add_fault_bc(0, "F")
+    st.solve()
+    info = st._rotated_freeslip_info
+    assert info["converged"]
+    from underworld3.utilities.fault_contact import fault_slip
+    _s, V, _leak = fault_slip(st, "F", info)
+    return float(np.abs(V).max())
+
+
+def test_a_finely_sampled_arc_places_with_the_same_slip():
+    box = uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                            cellSize=H, regular=True)
+    slips = [_slip(box.add_fault(("F", _arc(ds)))) for ds in (1.0, 0.5, 0.3)]
+    spread = (max(slips) - min(slips)) / max(slips)
+    # 7.3e-5 measured; development's every-sample pull spread up to 8e-2 on such traces
+    assert spread < 1.0e-3, slips
