+def _cell_size_near(dm, poly):
+    """Mean edge length of the mesh within the trace's bounding box, grown by a
+    tenth of its diagonal. COLLECTIVE: summed over the ranks, so every rank gets
+    the same number."""
+    from underworld3.utilities.line_cut import _coords, _edge_vertices
+
+    X = _coords(dm)
+    ends = _edge_vertices(dm)
+    lo, hi = poly.min(axis=0), poly.max(axis=0)
+    grow = 0.1 * float(np.linalg.norm(hi - lo))
+    mid = 0.5 * (X[ends[:, 0]] + X[ends[:, 1]])
+    near = np.all((mid >= lo - grow) & (mid <= hi + grow), axis=1)
+    lengths = np.linalg.norm(X[ends[near, 0]] - X[ends[near, 1]], axis=1)
+    tot = uw.mpi.comm.allreduce(np.array([lengths.sum(), lengths.size], dtype=float),
+                                op=MPI.SUM)
+    return float(tot[0] / tot[1]) if tot[1] else float("nan")
+
+
+# add_fault pulls a vertex onto the trace's tips, onto its turns of more than
+# _PULL_TURN_DEG, and onto every sample within _SHARP_REACH cells of a turn of
+# more than _SHARP_TURN_DEG; the cut follows the whole trace between them.
+_PULL_TURN_DEG = 45.0
+_SHARP_TURN_DEG = 90.0
+_SHARP_REACH = 1.5
+# add_fault's default snap fraction (cut_along_lines' own default is 0.1): with
+# fewer pulled vertices the cut's crossing points sit closer to existing ones,
+# and a larger snap keeps the cells sound (smallest angle 15-24 degrees against
+# 4-7 at 0.1, measured; register row 29).
+_ADD_FAULT_SNAP_FRAC = 0.3
+
+
+def _pulled_samples(dm, poly):
+    """The samples of ``poly`` that add_fault puts a mesh vertex on (row 29).
+
+    Pulling every sample of a trace sampled finer than the mesh distorted the
+    cells until the cut's snap inverted them, or let two samples share a vertex
+    and break the chain; and the answer followed the sampling (a fault's slip
+    moved up to 8 % between samplings of one trace). A tip, and a turn, still
+    need a vertex of their own: without one a sharp turn crosses a cell edge
+    twice. COLLECTIVE (the cell size near the trace is reduced)."""
+    P = np.asarray(poly, dtype=float)
+    if len(P) <= 2:
+        return P
+    a = P[1:-1] - P[:-2]
+    b = P[2:] - P[1:-1]
+    cos = np.einsum("ij,ij->i", a, b) / (np.linalg.norm(a, axis=1) * np.linalg.norm(b, axis=1))
+    turn = np.degrees(np.arccos(np.clip(cos, -1.0, 1.0)))
+    keep = np.zeros(len(P), dtype=bool)
+    keep[[0, -1]] = True
+    keep[1:-1] |= turn > _PULL_TURN_DEG
+    sharp = 1 + np.flatnonzero(turn > _SHARP_TURN_DEG)
+    if sharp.size:
+        reach = _SHARP_REACH * _cell_size_near(dm, P)
+        for i in sharp:
+            keep |= np.linalg.norm(P - P[i], axis=1) <= reach
+    return P[keep]
+
+
