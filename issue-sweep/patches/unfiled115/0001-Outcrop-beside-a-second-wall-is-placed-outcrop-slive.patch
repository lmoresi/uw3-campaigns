+# Below this smallest angle, in degrees, in the cells where an outcropping band meets
+# the wall, the placement warns. Measured on an annulus (dips 10-60 degrees, two cell
+# sizes): the angle there depends on where the band crosses the wall relative to the
+# wall's own vertices, and jumps from below 1 to 30 degrees between depths a tenth of
+# a cell apart. Moving the trace's top by 0.1-0.2 cells cleared 27 of 43 cases below
+# 5 degrees, and by up to 0.4 cells 33 of 43: nearly all at dips of 20 degrees and
+# more, about half at 10-15.
+_OUTCROP_SLIVER_DEG = 5.0
+
+
+def _outcrop_sliver_angle(dm, band, fault_labels=()):
+    """The smallest angle, in degrees, of the cells beside the wall where the band
+    meets it (band cells and their neighbours that touch a wall vertex); 180 when
+    the band does not reach the wall. The same on every rank (a minimum over them).
+
+    A split fault's sides are boundary too; their vertices (``fault_labels``, the
+    split's side labels) are not the wall's, since a fault is strictly interior."""
+    vS, vE = dm.getDepthStratum(0)
+    X = _coords(dm)[: vE - vS]
+    cells = _cells_anticlockwise(dm, X)
+    on_wall = _true_wall_vertex_mask(dm, len(X)).copy()
+    for name in fault_labels:
+        if not dm.hasLabel(name):
+            continue
+        lab = dm.getLabel(name)
+        for value in lab.getValueIS().getIndices():
+            for p in lab.getStratumIS(int(value)).getIndices():
+                for q in dm.getTransitiveClosure(int(p))[0]:
+                    if vS <= q < vE:
+                        on_wall[int(q) - vS] = False
+    band = np.asarray(band, dtype=bool)[: len(cells)]
+    smallest = 180.0
+    if band.any() and on_wall[cells[band]].any():
+        near = np.zeros(len(X), dtype=bool)
+        near[cells[band].ravel()] = True
+        beside = near[cells].any(axis=1) & on_wall[cells].any(axis=1)
+        for tri in cells[beside]:
+            P = X[tri]
+            for i in range(3):
+                u, w = P[(i + 1) % 3] - P[i], P[(i + 2) % 3] - P[i]
+                c = float(u @ w / (np.linalg.norm(u) * np.linalg.norm(w)))
+                smallest = min(smallest, float(np.degrees(np.arccos(np.clip(c, -1, 1)))))
+    return uw.mpi.comm.allreduce(smallest, op=MPI.MIN)
+
