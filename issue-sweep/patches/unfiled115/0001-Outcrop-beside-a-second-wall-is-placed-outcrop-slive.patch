+++ b/tests/test_0907_outcrop_beside_a_second_wall.py
@@ -0,0 +1,86 @@
+"""An outcrop whose cavity also runs along a second wall is placed; slivers are warned of.
+
+A ladder band outcropping through one wall of a box, next to a corner, carves a
+cavity that also reaches the other wall. That was refused ("only a one-band outcrop
+is built"). Like an interior band beside a wall, it is now placed, unless its gap to
+the second wall is below 0.3 wall cells.
+
+Where an outcropping band meets the wall, the cells can be slivers: the smallest
+angle depends on where the band crosses the wall relative to the wall's own
+vertices. That is a known limit of the outcrop path; the placement warns below 5
+degrees, the same on every rank, and records the angle in ``info``.
+
+Asserted as relations: the corner placement keeps both walls' labels and the corner
+vertex; the warning is printed exactly when the recorded angle is below the limit; a
+sliver-prone outcrop records a smaller angle than a clean one; an interior placement
+records none (180).
+"""
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities import place_surface
+from underworld3.utilities.place_surface import place_fault_ribbon_2d
+
+pytestmark = [pytest.mark.level_2, pytest.mark.tier_b]
+
+
+def test_an_outcrop_beside_a_corner_reaching_the_other_wall_is_placed():
+    h = 0.05
+    box = uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                            cellSize=h, regular=True)
+    d = np.array([-1.0, -1.0]) / np.sqrt(2)
+    # the band crosses Top (its corner 0.12 cells past it) and its cavity reaches
+    # Right, 1.9 cells away
+    top = np.array([1 - 4 * h, 1 - 2 * h])
+    trace = top + (h * np.arange(7))[:, None] * d
+    mesh, _info = place_fault_ribbon_2d(box, [("Fault", trace)], 2 * h, margin_rings=2,
+                                        clearance=0.3, split=True, mesher="ladder")
+    dm = mesh.dm
+    vS, _vE = dm.getDepthStratum(0)
+    eS, eE = dm.getDepthStratum(1)
+    X = dm.getCoordinatesLocal().array.reshape(-1, 2)
+    value = {b.name: b.value for b in mesh.boundaries}
+    unlabelled = 0
+    for e in range(eS, eE):
+        if dm.getSupportSize(e) != 1:
+            continue
+        v = [int(q) - vS for q in dm.getCone(e)]
+        for name, ax in (("Top", 1), ("Right", 0)):
+            if (np.abs(X[v, ax] - 1.0) < 1e-9).all():
+                unlabelled += dm.getLabel(name).getValue(e) != value[name]
+    assert unlabelled == 0
+    assert (np.linalg.norm(X - [1.0, 1.0], axis=1) < 1e-12).sum() == 1
+    assert "FaultPlus" in value
+
+
+@pytest.fixture(scope="module")
+def annulus():
+    return uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.4, cellSize=0.05,
+                              refinement=1, qdegree=2)
+
+
+def _place(annulus, dip_deg, k):
+    h = 0.025
+    th, dip = np.radians(90.0), np.radians(dip_deg)
+    r_hat = np.array([np.cos(th), np.sin(th)])
+    t_hat = np.array([-np.sin(th), np.cos(th)])
+    down = -np.cos(dip) * t_hat - np.sin(dip) * r_hat
+    trace = (1.0 - k * h) * r_hat + (h * np.arange(7))[:, None] * down
+    _mesh, info = place_fault_ribbon_2d(annulus, [("Fault", trace)], 2 * h, margin_rings=2,
+                                        clearance=0.3, split=True, mesher="ladder")
+    return info["outcrop_min_angle"]
+
+
+def test_the_warning_follows_the_recorded_angle(annulus, capsys):
+    # measured: dip 15 at k 0.15 cells is a sliver (0.3 degrees); dip 45 at k 1.05 is
+    # clean (about 30); dip 30 at k 4 does not reach the wall
+    sliver = _place(annulus, 15, 0.15)
+    warned = "WARNING: where the band meets the domain wall" in capsys.readouterr().out
+    clean = _place(annulus, 45, 1.05)
+    clean_warned = "WARNING: where the band meets" in capsys.readouterr().out
+    interior = _place(annulus, 30, 4.0)
+    assert sliver < clean < 180.0 == interior
+    assert warned == (sliver < place_surface._OUTCROP_SLIVER_DEG)
+    assert clean_warned == (clean < place_surface._OUTCROP_SLIVER_DEG)
+    assert warned, "the sliver-prone outcrop should warn"
