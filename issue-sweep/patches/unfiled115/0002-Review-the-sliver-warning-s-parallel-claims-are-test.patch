@@ -0,0 +1,40 @@
+"""The outcrop sliver warning, at np 2: the same angle on every rank, printed once.
+
+The smallest angle where an outcropping band meets the wall is a minimum over the
+ranks, so it is the same on every rank even when only one of them holds wall cells;
+the warning is printed once (rank 0). With the top at 63.5 degrees on this annulus
+the outcrop's surgery runs on rank 1 at np 2, so rank 0 holds no wall cell of it and
+would report 180 without the reduction.
+
+    mpirun -n 2 python -m pytest --with-mpi tests/parallel/test_0907_outcrop_sliver_warning_parallel.py
+"""
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities import place_surface
+from underworld3.utilities.place_surface import place_fault_ribbon_2d
+
+pytestmark = [pytest.mark.mpi(min_size=2), pytest.mark.level_2, pytest.mark.tier_b,
+              pytest.mark.timeout(600)]
+
+
+def test_the_angle_is_the_same_everywhere_and_the_warning_prints_once(capsys):
+    base = uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.4, cellSize=0.05,
+                              refinement=1, qdegree=2)
+    h, th, dip = 0.025, np.radians(63.5), np.radians(15.0)
+    r_hat = np.array([np.cos(th), np.sin(th)])
+    t_hat = np.array([-np.sin(th), np.cos(th)])
+    down = -np.cos(dip) * t_hat - np.sin(dip) * r_hat
+    trace = (1.0 - 0.15 * h) * r_hat + (h * np.arange(7))[:, None] * down
+    _mesh, info = place_fault_ribbon_2d(base, [("Fault", trace)], 2 * h, margin_rings=2,
+                                        clearance=0.3, split=True, mesher="ladder")
+    angle = info["outcrop_min_angle"]
+    printed = "WARNING: where the band meets the domain wall" in capsys.readouterr().out
+    comm = uw.mpi.comm
+    angles = comm.allgather(angle)
+    prints = comm.allgather(printed)
+    assert all(a == angles[0] for a in angles), angles
+    assert angles[0] < 180.0, "the outcrop reaches the wall on some rank"
+    warned = angles[0] < place_surface._OUTCROP_SLIVER_DEG
+    assert prints == [warned] + [False] * (comm.size - 1), prints
