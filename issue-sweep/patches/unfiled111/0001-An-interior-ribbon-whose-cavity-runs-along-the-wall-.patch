--- /dev/null
+++ b/tests/test_0904_place_ribbon_interior_beside_the_wall.py
@@ -0,0 +1,142 @@
+"""An interior ribbon close to a domain wall is placed; only a sliver's gap is refused.
+
+A ribbon whose band ended a few cells below the wall was refused: the cavity around
+the band reached the wall ("the volume must be interior, with clearance to spare"),
+and the band did not reach the wall either, so it could not be an outcrop. On an
+annulus with a ladder ribbon, every band whose highest corner lay between 0 and
+about 2 cells below the wall was refused, at any dip and cell size; a slab model
+lost the middle of its dip scan to it.
+
+The wall's vertices are protected from the carve, so the cavity can run along the
+wall and keep the wall's edges and labels. It is placed now, unless the gap between
+the band's skin and the wall is below 0.3 of the wall's cells, where the cells
+filled in between would be slivers; that refusal gives the gap in cells.
+
+The fixture is an annulus (inner radius 0.4) with one refinement, and a ribbon 2
+cells wide on a 7-point trace a cell apart, dipping 30 degrees, its top k cells
+below the outer wall, 2 margin rings, clearance 0.3, split. Asserted as relations:
+the band does not touch the wall, every outer-wall edge keeps its label, the fault
+is split, and the cells beside the wall are no worse than 0.8 of those of the same
+ribbon placed deep (k = 6) on the same mesh. A box corner, where the cavity runs
+along two walls, keeps both walls' labels and the corner vertex.
+"""
+import re
+
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities.place_surface import place_fault_ribbon_2d
+
+pytestmark = [pytest.mark.level_2, pytest.mark.tier_b]
+
+DIP = np.radians(30.0)
+R_HAT = np.array([0.0, 1.0])
+T_HAT = np.array([-1.0, 0.0])
+DOWN = -np.cos(DIP) * T_HAT - np.sin(DIP) * R_HAT
+
+
+@pytest.fixture(scope="module", params=[0.05, 0.025], ids=["h0.025", "h0.0125"])
+def annulus(request):
+    return uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.4, cellSize=request.param,
+                              refinement=1, qdegree=2), request.param / 2
+
+
+def _place(mesh, h, k):
+    trace = (1.0 - k * h) * R_HAT + (h * np.arange(7))[:, None] * DOWN
+    return place_fault_ribbon_2d(mesh, [("Fault", trace)], 2 * h, margin_rings=2,
+                                 clearance=0.3, split=True, mesher="ladder")
+
+
+def _band_gap_cells(h, k):
+    """The band's highest corner below the outer circle, in nominal cells."""
+    top = (1.0 - k * h) * R_HAT
+    ext = top - 2 * h * DOWN
+    rail = h * np.array([DOWN[1], -DOWN[0]])
+    return (1.0 - max(np.linalg.norm(ext + rail), np.linalg.norm(ext - rail))) / h
+
+
+def _angles(P):
+    out = []
+    for i in range(3):
+        u, w = P[(i + 1) % 3] - P[i], P[(i + 2) % 3] - P[i]
+        out.append(np.degrees(np.arccos(np.clip(u @ w / np.linalg.norm(u) / np.linalg.norm(w),
+                                                -1, 1))))
+    return min(out)
+
+
+def _inspect(mesh, info, on_wall_of, wall_labels, near):
+    """Band cells on the wall, wall edges without their label, the smallest
+    angle of the cells touching a wall near ``near``."""
+    dm = mesh.dm
+    vS, vE = dm.getDepthStratum(0)
+    eS, eE = dm.getDepthStratum(1)
+    cS, cE = dm.getHeightStratum(0)
+    X = dm.getCoordinatesLocal().array.reshape(-1, 2)
+    value = {b.name: b.value for b in mesh.boundaries}
+    unlabelled = 0
+    for e in range(eS, eE):
+        if dm.getSupportSize(e) != 1:
+            continue
+        v = [int(q) - vS for q in dm.getCone(e)]
+        for name in wall_labels:
+            if on_wall_of[name](X[v]).all() and dm.getLabel(name).getValue(e) != value[name]:
+                unlabelled += 1
+    band_on_wall, smallest = 0, 180.0
+    band = np.asarray(info["band"])
+    for c in range(cS, cE):
+        cl = dm.getTransitiveClosure(c)[0]
+        P = X[cl[(cl >= vS) & (cl < vE)] - vS]
+        touches = any(on_wall_of[n](P).any() for n in wall_labels)
+        if touches and band[c - cS]:
+            band_on_wall += 1
+        if touches and np.linalg.norm(P.mean(0) - near) < 0.3:
+            smallest = min(smallest, _angles(P))
+    return band_on_wall, unlabelled, smallest, "FaultPlus" in value
+
+
+OUTER = {"Upper": lambda P: np.linalg.norm(P, axis=1) > 1.0 - 1e-6}
+
+
+@pytest.mark.parametrize("k", [2.5, 3.0, 3.5])
+def test_a_band_two_cells_below_the_wall_is_placed_inside(annulus, k):
+    mesh, h = annulus
+    deep = _inspect(*_place(mesh, h, 6.0), OUTER, ["Upper"], R_HAT)
+    band_on_wall, unlabelled, smallest, split = _inspect(*_place(mesh, h, k), OUTER,
+                                                         ["Upper"], R_HAT)
+    assert band_on_wall == 0 and unlabelled == 0 and split
+    assert smallest >= 0.8 * deep[2], (smallest, deep[2])
+
+
+def test_a_sliver_gap_is_refused_with_the_gap_in_cells(annulus):
+    mesh, h = annulus
+    k = 1.95
+    with pytest.raises(RuntimeError, match="comes within") as err:
+        _place(mesh, h, k)
+    m = re.search(r"within ([0-9.]+) cells \(([0-9.e+-]+)\) of the domain wall at "
+                  r"\([^)]*\), whose cells there are ([0-9.e+-]*[0-9])", str(err.value))
+    assert m, str(err.value)
+    cells, gap, h_wall = (float(x) for x in m.groups())
+    # the reported gap against the band's corner below the circle (the wall's
+    # chords sit inside it by about h^2/8, under 0.01 cells here)
+    assert abs(cells - _band_gap_cells(h, k) * h / h_wall) < 0.05, (cells, err.value)
+    assert 0 < cells < 0.3
+    assert "further from the wall" in str(err.value) and "outcrop" in str(err.value)
+
+
+def test_a_band_beside_a_box_corner_keeps_both_walls():
+    h = 0.05
+    box = uw.meshing.UnstructuredSimplexBox(minCoords=(0, 0), maxCoords=(1, 1),
+                                            cellSize=h, regular=True)
+    d = np.array([-1.0, -1.0]) / np.sqrt(2)
+    top = np.array([1 - 2.5 * h, 1 - 2.5 * h])          # band corner 0.38 cells off both
+    trace = top + (h * np.arange(7))[:, None] * d
+    mesh, info = place_fault_ribbon_2d(box, [("Fault", trace)], 2 * h, margin_rings=2,
+                                       clearance=0.3, split=True, mesher="ladder")
+    walls = {"Top": lambda P: np.abs(P[:, 1] - 1) < 1e-9,
+             "Right": lambda P: np.abs(P[:, 0] - 1) < 1e-9}
+    band_on_wall, unlabelled, _smallest, split = _inspect(mesh, info, walls,
+                                                          ["Top", "Right"], np.array([1.0, 1.0]))
+    X = mesh.dm.getCoordinatesLocal().array.reshape(-1, 2)
+    assert band_on_wall == 0 and unlabelled == 0 and split
+    assert (np.linalg.norm(X - [1.0, 1.0], axis=1) < 1e-12).sum() == 1
