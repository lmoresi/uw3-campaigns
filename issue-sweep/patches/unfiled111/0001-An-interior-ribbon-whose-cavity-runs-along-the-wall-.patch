+def _wall_gap_2d(ring, X, on_wall, asm_pts, skin_edges, h_vertex):
+    """The gap between the band's skin and the wall a 2-D cavity's ``ring``
+    runs along, and the wall's cell size there.
+
+    The gap is the smaller of the wall vertices' distance to the skin and the
+    skin's vertices' distance to the ring's wall edges (consecutive ring entries,
+    both existing wall vertices). The cell size is the mean length of the ring's wall edges
+    at the nearest wall vertex, or that vertex's ``h`` when no ring edge lies on
+    the wall. Returns ``(gap, h, point)``, ``point`` the nearest wall vertex."""
