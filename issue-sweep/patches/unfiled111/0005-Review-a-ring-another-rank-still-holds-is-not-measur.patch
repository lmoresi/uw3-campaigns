+def _refuse_a_partial_ring(ring, shared_v, n_old):
+    """Refuse to measure a wall gap on a cavity ring that another rank also holds.
+
+    The gathered path moves the band's star and one more layer onto the surgery
+    rank, so its ring should hold no vertex shared with another rank (measured:
+    none in 144 placements at 2-3 ranks). That rests on the reach arithmetic,
+    untested on a strongly graded mesh; a ring that still has a shared vertex is
+    partial here, and its gap and cell size would be wrong. The placement's
+    failure gather makes the refusal collective."""
+    old = np.asarray([int(v) for v in ring if int(v) < n_old], dtype=np.int64)
+    if old.size and shared_v[old].any():
+        raise RuntimeError(
+            "the gathered region does not cover the cavity ring: a vertex of it "
+            "is shared with another rank, so the gap to the wall cannot be measured "
+            "on this rank alone")
+
