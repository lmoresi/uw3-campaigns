@@ -0,0 +1,61 @@
+"""A ribbon beside a wall, at any rank count: the gathered path places it, the
+seam-conforming path refuses it, and every rank agrees.
+
+Seam-conforming, at np 3 with the top at 60 degrees on the annulus, one rank's
+fill ring held a chord across the band and gmsh spun on it while the other ranks
+waited; at np 2 the outcome depended on the partition. That path refuses a cavity
+along the wall again, with the remedy, before any rank meshes; the gathered path,
+the default, places it (tests/test_0904).
+
+    mpirun -n 3 python -m pytest --with-mpi tests/parallel/test_0904_place_ribbon_beside_the_wall_parallel.py
+"""
+import numpy as np
+import pytest
+
+import underworld3 as uw
+from underworld3.utilities.place_surface import place_fault_ribbon_2d
+
+pytestmark = [pytest.mark.mpi(min_size=2), pytest.mark.level_2, pytest.mark.tier_b,
+              pytest.mark.timeout(600)]
+
+H = 0.025
+
+
+@pytest.fixture(scope="module")
+def annulus():
+    return uw.meshing.Annulus(radiusOuter=1.0, radiusInner=0.4, cellSize=2 * H,
+                              refinement=1, qdegree=2)
+
+
+def _trace(k, theta=60.0, dip=30.0):
+    th, d = np.radians(theta), np.radians(dip)
+    r_hat = np.array([np.cos(th), np.sin(th)])
+    t_hat = np.array([-np.sin(th), np.cos(th)])
+    down = -np.cos(d) * t_hat - np.sin(d) * r_hat
+    return (1.0 - k * H) * r_hat + (H * np.arange(7))[:, None] * down
+
+
+def _outcome(annulus, k, seams):
+    try:
+        place_fault_ribbon_2d(annulus, [("Fault", _trace(k))], 2 * H, margin_rings=2,
+                              clearance=0.3, split=True, seams=seams,
+                              # as the slab driver pairs them: the seam-conforming
+                              # path takes the network mesher
+                              mesher="ladder" if seams == "gather" else "network")
+        out = "placed"
+    except Exception as exc:     # noqa: BLE001 - compared across the ranks
+        out = f"{type(exc).__name__}: {exc}"
+    every = uw.mpi.comm.allgather(out)
+    assert all(o == every[0] for o in every), every
+    return every[0]
+
+
+@pytest.mark.parametrize("k", [2.196, 2.5], ids=["gap0.31", "gap0.61"])
+def test_the_gathered_path_places_it(annulus, k):
+    assert _outcome(annulus, k, "gather") == "placed"
+
+
+@pytest.mark.parametrize("k", [2.196, 2.5], ids=["gap0.31", "gap0.61"])
+def test_the_seam_conforming_path_refuses_it_before_meshing(annulus, k):
+    out = _outcome(annulus, k, "conform")
+    assert "seam-conforming path" in out and "seams='gather'" in out, out
