@@ -152,7 +152,7 @@ def test_a_healthy_job_is_left_alone(tmp_path):
 # in for mpirun and its rank (the supervisor dumps the job's descendants).
 # Every supervised job made a handler directory (uw-supervisor-*) and, without
 # --artifacts, a stacks directory (uw-stacks-*) holding an empty placeholder per
-# process, and kept both; a Linux server's /tmp filled with them (UNFILED 93).
+# process, and kept both; a Linux server's /tmp filled with them.
 N_SUPERVISED = 3
 
 
@@ -191,6 +191,25 @@ def test_a_supervised_hang_keeps_its_stacks(tmp_path):
     assert not [d for d in tmp.iterdir() if d.name.startswith("uw-supervisor-")]
 
 
+def test_a_supervisor_ended_by_sigterm_still_tidies(tmp_path):
+    """A walltime, a `timeout` or a cancelled CI job ends the supervisor with
+    SIGTERM; its directories go all the same."""
+    import signal
+    job = tmp_path / "slow_job.py"
+    job.write_text("import time\nprint('started', flush=True)\ntime.sleep(20)\n")
+    tmp = tmp_path / "tmp"
+    tmp.mkdir()
+    env = dict(os.environ, TMPDIR=str(tmp))
+    supervisor = subprocess.Popen(
+        [sys.executable, str(SUPERVISOR), "--silence", str(SILENCE), "--",
+         "/bin/sh", "-c", f'"{sys.executable}" "{job}"; exit $?'],
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
+    assert "started" in supervisor.stdout.readline()
+    supervisor.send_signal(signal.SIGTERM)
+    assert supervisor.wait(timeout=30) == 128 + signal.SIGTERM
+    assert sorted(os.listdir(tmp)) == [], f"left in the temporary directory: {os.listdir(tmp)}"
+
+
 # The native path, serially: a script stands in for gdb.
 TRANSCRIPT = """Thread 2 (Thread 0x7f (LWP 2) "async"):
 #0  __GI___poll (fds=0x1) at poll.c:29
