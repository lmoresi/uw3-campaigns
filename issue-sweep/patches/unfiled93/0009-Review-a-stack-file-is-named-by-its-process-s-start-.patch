+
+
+def test_a_reused_pid_keeps_only_the_asked_processs_record(supervisor, tmp_path):
+    """Two processes of one job held pid 4242 in turn. The tidy keys on the file
+    the dump request went to (the newer start token), not on the pid."""
+    stacks = tmp_path / "stacks"
+    stacks.mkdir()
+    earlier, live = stacks / "rank_0_pid_4242_100.stack", stacks / "rank_0_pid_4242_200.stack"
+    earlier.touch()
+    live.touch()
+    assert supervisor._stack_name(live) == ("0", 4242, 200)
+    supervisor._tidy(tmp_path / "no-handler", stacks, ours=False, asked={live.name})
+    assert sorted(p.name for p in stacks.iterdir()) == [live.name]
