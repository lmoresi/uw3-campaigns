--- a/tests/test_0063_mpi_hang_supervisor.py
+++ b/tests/test_0063_mpi_hang_supervisor.py
@@ -214,6 +214,60 @@ def test_a_supervised_hang_keeps_its_stacks_and_a_silent_ranks_record(tmp_path):
     assert stacks["rank_1"].stat().st_size == 0, "the silent rank's record was not kept empty"
     assert not list(kept[0].glob(f"*_pid_{helper.read_text()}_*.stack"))
     assert not [d for d in tmp.iterdir() if d.name.startswith("uw-supervisor-")]
+    # the report names the rank that did not answer
+    assert "rank 1 (pid" in completed.stdout and "did not answer" in completed.stdout, \
+        completed.stdout
+
+
+def _hang(tmp_path, command):
+    tmp = tmp_path / "tmp"
+    tmp.mkdir()
+    completed = subprocess.run(
+        [sys.executable, str(SUPERVISOR), "--silence", "5", "--", *command],
+        capture_output=True, text=True, timeout=BUDGET, env=dict(os.environ, TMPDIR=str(tmp)))
+    assert completed.returncode == 124, f"{completed.stdout}\n{completed.stderr}"
+    files = [p for d in tmp.iterdir() if d.name.startswith("uw-stacks-")
+             for p in d.glob("rank_*_pid_*.stack")]
+    return completed, files
+
+
+def test_a_python_driver_is_not_asked_or_counted_as_a_rank(tmp_path):
+    """A Python driver that starts its ranks itself is a launcher: it is not
+    asked for a stack, so it cannot be named as the rank somewhere the others
+    are not."""
+    rank = tmp_path / "rank.py"
+    rank.write_text("import time\nprint('rank started', flush=True)\ntime.sleep(600)\n")
+    driver = tmp_path / "driver.py"
+    driver.write_text(
+        "import os, subprocess, sys\n"
+        "print('driver', os.getpid(), flush=True)\n"
+        f"kids = [subprocess.Popen([sys.executable, {str(rank)!r}],\n"
+        "                         env=dict(os.environ, OMPI_COMM_WORLD_RANK=str(r))) for r in (0, 1)]\n"
+        "[k.wait() for k in kids]\n")
+    completed, files = _hang(tmp_path, [sys.executable, str(driver)])
+    driver_pid = completed.stdout.split("driver ", 1)[1].split()[0]
+    assert not [p for p in files if f"_pid_{driver_pid}_" in p.name], [p.name for p in files]
+    assert sorted(p.name.split("_pid_")[0] for p in files) == ["rank_0", "rank_1"]
+    assert all(p.stat().st_size > 0 for p in files)
+
+
+def test_a_launcher_that_forwards_the_signal_is_not_asked(tmp_path):
+    """mpirun forwards SIGUSR1 to its ranks. Asked as well, it would make each rank
+    dump twice per sample; a shell that forwards it stands in for mpirun."""
+    rank = tmp_path / "rank.py"
+    rank.write_text("import time\nprint('rank started', flush=True)\ntime.sleep(600)\n")
+    forwarder = tmp_path / "forwarder.sh"
+    forwarder.write_text(
+        f'OMPI_COMM_WORLD_RANK=0 "{sys.executable}" "{rank}" &\n'
+        "child=$!\n"
+        "trap 'kill -USR1 $child' USR1\n"
+        "while kill -0 $child 2>/dev/null; do wait $child; done\n")
+    # "; exit $?" keeps the outer shell from exec'ing the forwarder: the
+    # forwarder must be a descendant of the job, as mpirun is of a batch script
+    _completed, files = _hang(tmp_path, ["/bin/sh", "-c", f'/bin/sh "{forwarder}"; exit $?'])
+    assert len(files) == 1, files
+    # two samples, one thread: two dumps, not four
+    assert files[0].read_text().count("most recent call first") == 2, files[0].read_text()
 
 
