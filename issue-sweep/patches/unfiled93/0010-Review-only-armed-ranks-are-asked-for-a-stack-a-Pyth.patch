@@ -233,6 +233,32 @@ def _stack_name(path):
     return rank, int(pid), int(token or 0)
 
 
+def _armed_ranks(job_pid, dump_dir):
+    """The processes to ask for a stack, as ``{pid: (rank, stack file name)}``.
+
+    Only processes this module armed, the job and its descendants that have a
+    stack file, are asked: a launcher that is not Python (mpirun, srun, a shell)
+    has none, and a SIGUSR1 sent to it may be forwarded to the ranks, which would
+    then dump twice. For a pid held in turn by two processes of the job, the
+    newest file is the live one (the earlier armed first, with a smaller token).
+
+    A Python process with an armed descendant of a different rank is a launcher
+    (a Python driver starting its ranks): it is neither asked nor counted, or it
+    would be named as the odd rank out. A rank's own helpers (a compile) inherit
+    its rank variable, so a rank with a helper running is still asked.
+    """
+    tree = [job_pid] + _descendants(job_pid)
+    newest = {}
+    for path in Path(dump_dir).glob("rank_*_pid_*.stack"):
+        rank, pid, token = _stack_name(path)
+        if pid in tree and token >= newest.get(pid, (-1, None, None))[0]:
+            newest[pid] = (token, rank, path.name)
+    armed = {pid: (rank, name) for pid, (_token, rank, name) in newest.items()}
+    launchers = {pid for pid, (rank, _name) in armed.items()
+                 if any(q in armed and armed[q][0] != rank for q in _descendants(pid))}
+    return {pid: v for pid, v in armed.items() if pid not in launchers}
+
+
