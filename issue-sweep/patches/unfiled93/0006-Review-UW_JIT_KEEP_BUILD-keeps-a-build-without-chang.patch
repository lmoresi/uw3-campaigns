+def _keep_build(debug):
+    """Whether a build directory is kept: ``debug=True``, or ``UW_JIT_KEEP_BUILD=1``
+    to keep the sources of the kernels a run actually compiles (``debug`` also
+    changes them, adding a trace to every kernel)."""
+    return bool(debug) or os.environ.get("UW_JIT_KEEP_BUILD", "").lower() in ("1", "true", "yes")
+
+
+def _kept_note(debug):
+    """What the verbose build line adds about the directory it names."""
+    return "" if _keep_build(debug) else "\n(removed once loaded; UW_JIT_KEEP_BUILD=1 keeps it)"
+
+
 def _discard_build(tmpdir, keep=False):
     """Remove a build directory once its module is loaded (and cached).
 
     The loaded module does not need it: the dynamic loader holds the mapped
     ``.so`` open, and an unlinked file stays readable for as long as it is
     mapped, on Linux and on macOS. Kept were one directory, and a dozen or more
-    inodes, per compile per rank, for good; they filled a server's ``/tmp``
-    (UNFILED 93). Rank-local and best-effort: a directory that cannot be removed
-    is left, and nothing is decided on it, so the ranks cannot diverge here.
-
-    ``keep`` (``debug=True``) leaves it for reading the generated sources.
+    inodes, per compile per rank, for good, and they filled a server's ``/tmp``.
+    Rank-local and best-effort: a directory that cannot be removed is left, and
+    nothing is decided on it, so the ranks cannot diverge here.
+
+    What is lost: a debugger reads no symbols from the deleted mapping, so
+    native frames inside a kernel show as ``??``, and a traceback through
+    ``cy_ext.pyx`` has no source lines; keep the build to have them. With
+    ``TMPDIR`` on NFS the client renames the mapped ``.so`` to ``.nfsXXXX``
+    rather than removing it, so an empty directory stays per compile; keep
+    ``TMPDIR`` on a local disk.
     """
     if keep or tmpdir is None:
         return
