diff --git a/tests/test_0903_jit_build_leaves_no_temp_dir.py b/tests/test_0903_jit_build_leaves_no_temp_dir.py
new file mode 100644
index 00000000..de601b33
--- /dev/null
+++ b/tests/test_0903_jit_build_leaves_no_temp_dir.py
@@ -0,0 +1,104 @@
+"""A JIT compile leaves nothing behind in the temporary directory (UNFILED 93).
+
+Every compile built its extension in a directory of its own under a hard-coded
+``/tmp`` and left it there: one ``fn_ptr_ext_<hash>_<pid>_<time>_<n>`` per
+compile. A Linux server's ``/tmp`` (a tmpfs of 1,048,576 inodes) filled with
+them and stopped every session on it.
+
+What is asserted:
+
+* the build directory is made under the temporary directory Python is pointed
+  at (``TMPDIR``), not ``/tmp`` regardless;
+* after N compiles the temporary directory holds nothing new, the compiler's
+  own scratch files included;
+* a solver whose kernels were loaded from a build directory that has since been
+  removed still solves, exactly: u = x^2 - y^2 is harmonic and quadratic, so a
+  degree-2 field reproduces it to the solver's tolerance (1e-12 here);
+* ``debug=True`` keeps the directory, for reading the generated sources.
+"""
+import os
+import tempfile
+
+import numpy as np
+import pytest
+import sympy
+
+import underworld3 as uw
+from underworld3.utilities import _jitextension as _jitext
+from underworld3.utilities._jitextension import JITCallbackSet, getext
+
+pytestmark = [pytest.mark.level_1, pytest.mark.tier_b]
+
+N_COMPILES = 3
+
+
+@pytest.fixture
+def private_tmp(tmp_path, monkeypatch):
+    """A fresh temporary directory for this process and the compiler it runs,
+    a cold disk cache, an empty in-memory cache, and a record of every build
+    directory compile_and_load returns."""
+    tmp = tmp_path / "tmp"
+    tmp.mkdir()
+    monkeypatch.setenv("TMPDIR", str(tmp))
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp))
+    monkeypatch.setenv("UW_JIT_CACHE_DIR", str(tmp_path / "jit-cache"))
+    monkeypatch.setattr(_jitext, "_ext_dict", {})
+    built = []
+    real = _jitext.compile_and_load
+
+    def recording(*args, **kwargs):
+        module, where = real(*args, **kwargs)
+        built.append(where)
+        return module, where
+
+    monkeypatch.setattr(_jitext, "compile_and_load", recording)
+    return tmp, built
+
+
+def _compile(mesh, salt, **kwargs):
+    x, y = mesh.X
+    fn = sympy.ImmutableDenseMatrix([x * salt, y])
+    getext(mesh, JITCallbackSet(residual=(fn,)), mesh.vars.values(), cache=False, **kwargs)
+
+
+def test_n_compiles_leave_the_temporary_directory_as_they_found_it(private_tmp):
+    tmp, built = private_tmp
+    mesh = uw.meshing.UnstructuredSimplexBox(cellSize=0.25)
+    for k in range(N_COMPILES):
+        _compile(mesh, k + 2)
+    assert len(built) == N_COMPILES, built
+    assert all(os.path.dirname(os.path.abspath(d)) == str(tmp) for d in built), \
+        f"the build directories are not under TMPDIR={tmp}: {built}"
+    assert not any(os.path.exists(d) for d in built), \
+        f"build directories left behind: {[d for d in built if os.path.exists(d)]}"
+    assert sorted(os.listdir(tmp)) == [], f"left in the temporary directory: {os.listdir(tmp)}"
+
+
+def test_kernels_loaded_from_a_removed_build_directory_still_solve(private_tmp):
+    tmp, built = private_tmp
+    mesh = uw.meshing.UnstructuredSimplexBox(cellSize=0.25)
+    u = uw.discretisation.MeshVariable("u_0903", mesh, 1, degree=2)
+    x, y = mesh.X
+    exact = x**2 - y**2
+    poisson = uw.systems.Poisson(mesh, u_Field=u)
+    poisson.constitutive_model = uw.constitutive_models.DiffusionModel
+    poisson.constitutive_model.Parameters.diffusivity = 1
+    poisson.f = 0.0
+    for side in ("Top", "Bottom", "Left", "Right"):
+        poisson.add_dirichlet_bc(sympy.Matrix([exact]), side)
+    poisson.tolerance = 1e-12
+    poisson.solve()
+    assert built, "the solve compiled nothing, so it did not load from a build directory"
+    assert not any(os.path.exists(d) for d in built)
+    assert poisson.snes.getConvergedReason() > 0
+    X = u.coords
+    err = np.abs(u.array[:, 0, 0] - (X[:, 0] ** 2 - X[:, 1] ** 2)).max()
+    assert err < 1e-9, err
+    assert sorted(os.listdir(tmp)) == []
+
+
+def test_debug_keeps_the_build_directory(private_tmp):
+    _tmp, built = private_tmp
+    mesh = uw.meshing.UnstructuredSimplexBox(cellSize=0.25)
+    _compile(mesh, 7, debug=True, debug_name="T0903")
+    assert len(built) == 1 and os.path.exists(os.path.join(built[0], "cy_ext.h")), built
