          or os.environ.get("SLURM_PROCID")
          or "unknown")
 
-# A rank's own Python subprocesses (a setup.py build, its compiler driver)
-# inherit this module and the rank variable alike. One whose direct parent is a
-# process of the same rank that this module has already seen is such a helper,
-# and is not armed (it passes that on to its own children), so the stack files
-# are the ranks', and a silent rank's empty one is not buried among them. A rank
-# is a child of its launcher, not of an armed process, so it is armed under any
-# launcher, a rank variable or none.
-_seen = os.environ.get("UW_SUPERVISOR_SEEN", "")
-_helper = _seen == "%s:%d" % (_rank, os.getppid())
-os.environ["UW_SUPERVISOR_SEEN"] = "%s:%d" % (_rank, os.getpid())
-if not _helper:
-    # Held open for the life of the process on purpose: faulthandler keeps the
-    # descriptor, not this object, so letting it close would point the handler
-    # at whatever reuses the fd.
-    _path = os.path.join({str(dump_dir)!r}, "rank_%s_pid_%d.stack" % (_rank, os.getpid()))
-    _stream = open(_path, "w")
-    faulthandler.register(signal.SIGUSR1, file=_stream, all_threads=True, chain=False)
+# Held open for the life of the process on purpose: faulthandler keeps the
+# descriptor, not this object, so letting it close would point the handler at
+# whatever reuses the fd.
+_path = os.path.join({str(dump_dir)!r}, "rank_%s_pid_%d.stack" % (_rank, os.getpid()))
+_stream = open(_path, "w")
+faulthandler.register(signal.SIGUSR1, file=_stream, all_threads=True, chain=False)
 
 # Let the supervisor's gdb attach: where the kernel restricts ptrace to a process's
 # own descendants (Yama, the Ubuntu default), it would otherwise need root.
@@ -478,8 +467,8 @@ def main():
     # A supervisor ended by a signal (a walltime, a `timeout`, a cancelled CI
     # job) ends the job first, and waits for it (bounded by the kill ladder):
     # the ranks hold their stack files open, and mpirun and the ranks would
-    # otherwise run on. Then it tidies (no dump was asked for), and dies of the
-    # same signal, so its parent sees what ended it.
+    # otherwise run on. Then it tidies (keeping the empty file of any rank a dump
+    # was asked of), and dies of the same signal, so its parent sees what ended it.
     state = {}
 
     def ended_by(signum, _frame):
@@ -490,7 +479,8 @@ def main():
                 job.wait(timeout=SECONDS_TO_TERMINATE)
             except subprocess.TimeoutExpired:
                 pass
-        _tidy(handler_dir, dump_dir, ours=args.artifacts is None)
+        _tidy(handler_dir, dump_dir, ours=args.artifacts is None,
+              asked=state.get("asked"))
         signal.signal(signum, signal.SIG_DFL)
         os.kill(os.getpid(), signum)
 
@@ -503,28 +493,31 @@ def main():
         return status
     finally:
         _tidy(handler_dir, dump_dir, ours=args.artifacts is None,
-              killed=status == EXIT_KILLED)
+              asked=state.get("asked") if status == EXIT_KILLED else None)
 
 
-def _tidy(handler_dir, dump_dir, ours, killed=False):
+def _tidy(handler_dir, dump_dir, ours, asked=None):
     """Leave nothing behind but stacks that were actually dumped.
 
-    Every rank of the job opens its stack file at start-up (the handler needs
-    the descriptor before any signal arrives), so a healthy job leaves one empty
-    placeholder per rank, and every job leaves its handler directory. Kept, they filled a server's /tmp. A directory of our own making
+    Every Python process of the job opens its stack file at start-up (the
+    handler needs the descriptor before any signal arrives), so a healthy job
+    leaves one empty placeholder per process, and every job leaves its handler
+    directory. Kept, they filled a server's /tmp. A directory of our own making
     goes too once it is empty; one named by --artifacts stays.
 
-    After a kill the placeholders stay: an empty one is the record of a rank
-    (and its pid) that did not answer the dump request.
+    After a dump request (``asked``, the pids it went to) an empty placeholder
+    of a process that was asked stays: it is the record of a rank (and its pid)
+    that did not answer. One of a process no longer alive by then (a rank's
+    compiler, a build) goes, so that record is not buried among them.
     """
     shutil.rmtree(handler_dir, ignore_errors=True)
-    if killed:
-        return
+    asked = asked or set()
     for path in Path(dump_dir).glob("rank_*_pid_*.stack"):
         try:
-            if path.stat().st_size == 0:
+            pid = int(path.stem.rsplit("_pid_", 1)[1])
+            if path.stat().st_size == 0 and pid not in asked:
                 path.unlink()
-        except OSError:
+        except (OSError, ValueError):
             pass
     if ours:
         try:
@@ -564,6 +557,11 @@ def _supervise(args, command, env, dump_dir, state):
         print(f"\n=== MPI SUPERVISOR: {reason} ===", flush=True)
 
         ranks = _descendants(job.pid)
+        # the job itself, when it is a Python process this module armed (a
+        # serial job started with no launcher); a launcher is not signalled
+        if list(Path(dump_dir).glob(f"rank_*_pid_{job.pid}.stack")):
+            ranks = [job.pid] + ranks
+        state["asked"] = set(ranks)
         _request_dumps(ranks)
         time.sleep(SECONDS_TO_DUMP)
 
