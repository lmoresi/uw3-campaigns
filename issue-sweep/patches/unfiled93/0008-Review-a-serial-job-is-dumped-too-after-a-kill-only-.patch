@@ -216,6 +216,22 @@ def test_a_supervised_hang_keeps_its_stacks_and_a_silent_ranks_record(tmp_path):
     assert not [d for d in tmp.iterdir() if d.name.startswith("uw-supervisor-")]
 
 
+def test_a_serial_supervised_hang_dumps_its_stack(tmp_path):
+    """No launcher: the supervisor starts the Python job itself, which is then the
+    job, not a descendant of it, and must be asked for its stack too."""
+    job = tmp_path / "serial_job.py"
+    job.write_text("import time\nprint('started', flush=True)\ntime.sleep(600)\n")
+    tmp = tmp_path / "tmp"
+    tmp.mkdir()
+    completed = subprocess.run(
+        [sys.executable, str(SUPERVISOR), "--silence", "5", "--", sys.executable, str(job)],
+        capture_output=True, text=True, timeout=BUDGET, env=dict(os.environ, TMPDIR=str(tmp)))
+    assert completed.returncode == 124, f"{completed.stdout}\n{completed.stderr}"
+    stacks = [p for d in tmp.iterdir() if d.name.startswith("uw-stacks-")
+              for p in d.glob("rank_*_pid_*.stack")]
+    assert len(stacks) == 1 and stacks[0].stat().st_size > 0, stacks
+
+
 def _gone(pid):
     try:
         os.kill(pid, 0)
